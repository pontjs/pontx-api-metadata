        "en-US": "5394900b5e50d3372dad7720c961d326fc24e2f7e49706e610ce071e966d6025"
      },
      "license": "Proprietary",
      "attributionUrl": "https://developer.dida365.com/docs#/openapi",
      "documentationStatus": "official",
      "evidenceUrls": [
        "https://developer.dida365.com/docs#/openapi",
        "https://developer.dida365.com/docs/openapi.md"
      ],
      "verifiedAt": "2026-08-10",
      "stabilityNote": "官方 OAuth 2.0 API；读取和写入均需要用户授权，具体能力受 tasks:read / tasks:write scope 限制。",
      "accent": "#1dbf73",
      "packageName": "@pontx/api-dida365",
      "sdkVersion": "0.1.1",
      "sdkStatus": "published",
      "cliName": "dida",
      "proxyEnabled": true,
      "title": "滴答清单开放 API",
      "summary": "通过 OAuth 2.0 管理滴答清单的项目、任务、评论、标签、专注记录、倒数日、习惯与打卡。",
      "server": {
        "id": "default",
        "url": "https://api.dida365.com",
        "description": "Dida365 Open API"
      },
      "auth": [
        {
          "id": "OAuth2",
          "type": "oauth2",
          "envVar": "DIDA365_ACCESS_TOKEN",
          "tokenEndpointAuthMethod": "client_secret_post",
          "pkce": "unsupported",
          "credentialGuide": {
            "url": "https://developer.dida365.com/",
            "title": "前往滴答清单开发者中心申请凭证",
            "steps": [
              "登录开发者中心并创建一个应用（New App）。",
              "把 Pontx Hub 显示的回调地址填写到应用的 OAuth Redirect URL。",
              "保存应用，然后复制生成的 Client ID 和 Client Secret 到下方输入框。"
            ]
          },
          "description": "Dida365 OAuth 2.0 访问令牌（tasks:read / tasks:write）。请只在自己的会话中输入。"
        }
      ]
    },
