{
  "version": 1,
  "apis": [
    {
      "slug": "frankfurter",
      "name": "Frankfurter API",
      "provider": "Frankfurter",
      "category": "Finance",
      "featured": true,
      "sourceUrl": "https://raw.githubusercontent.com/pontjs/pontx-api-metadata/master/specs/frankfurter/openapi.json",
      "license": "MIT",
      "attributionUrl": "https://frankfurter.dev/",
      "approvedSha256": "67c13b8f2ab0182966473fd6db359b635388e96cec1f5126cdbb7e0ddf7968eb",
      "title": {
        "zh": "Frankfurter 汇率 API",
        "en": "Frankfurter exchange-rate API"
      },
      "summary": {
        "zh": "查询欧洲央行参考汇率、货币列表和指定日期区间的汇率变化。",
        "en": "Query ECB reference exchange rates, currencies, and historical rate movements."
      },
      "accent": "#2d6cdf",
      "packageName": "@pontx/api-frankfurter",
      "sdkVersion": "0.1.0",
      "sdkStatus": "planned",
      "proxyEnabled": true,
      "servers": [
        {
          "id": "default",
          "url": "https://api.frankfurter.dev/v1",
          "description": {
            "zh": "Frankfurter v1 公共 API",
            "en": "Frankfurter v1 public API"
          }
        }
      ],
      "auth": [],
      "operations": [
        {
          "slug": "get-latest-rates",
          "operationId": "getLatestRates",
          "tag": "Exchange Rates",
          "method": "GET",
          "path": "/latest",
          "title": {
            "zh": "获取最新汇率",
            "en": "Get latest exchange rates"
          },
          "description": {
            "zh": "返回最近一个有效参考日的汇率。",
            "en": "Retrieves the most recent exchange rates. Rates are updated daily around 16:00 CET.\nBy default, returns all available currencies with EUR as the base currency.\n"
          },
          "parameters": [
            {
              "name": "amount",
              "in": "query",
              "type": "number",
              "description": {
                "zh": "The amount to be converted (default is 1)",
                "en": "The amount to be converted (default is 1)"
              },
              "example": 100
            },
            {
              "name": "base",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Base currency code (three-letter ISO 4217 code)",
                "en": "Base currency code (three-letter ISO 4217 code)"
              },
              "example": "USD"
            },
            {
              "name": "symbols",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Comma-separated list of currency codes to limit the response.\nIf not specified, all available currencies are returned.\n",
                "en": "Comma-separated list of currency codes to limit the response.\nIf not specified, all available currencies are returned.\n"
              },
              "example": "USD,GBP,JPY"
            }
          ],
          "responseExample": {
            "amount": 1,
            "base": "EUR",
            "date": "2026-01-23",
            "rates": {
              "USD": 1.0445,
              "GBP": 0.8342,
              "JPY": 161.23,
              "CHF": 0.9234,
              "AUD": 1.6111
            }
          }
        },
        {
          "slug": "get-historical-rates",
          "operationId": "getHistoricalRates",
          "tag": "Exchange Rates",
          "method": "GET",
          "path": "/{date}",
          "title": {
            "zh": "获取历史汇率",
            "en": "Get historical exchange rates"
          },
          "description": {
            "zh": "返回指定参考日期的汇率。",
            "en": "Retrieves exchange rates for a specific date in the past.\nHistorical data is available from 1999-01-04 onwards.\n"
          },
          "parameters": [
            {
              "name": "date",
              "in": "path",
              "required": true,
              "type": "string",
              "description": {
                "zh": "Date in ISO 8601 format (YYYY-MM-DD)",
                "en": "Date in ISO 8601 format (YYYY-MM-DD)"
              },
              "example": "2024-01-15"
            },
            {
              "name": "amount",
              "in": "query",
              "type": "number",
              "description": {
                "zh": "The amount to be converted (default is 1)",
                "en": "The amount to be converted (default is 1)"
              },
              "example": 1
            },
            {
              "name": "base",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Base currency code (three-letter ISO 4217 code)",
                "en": "Base currency code (three-letter ISO 4217 code)"
              },
              "example": "EUR"
            },
            {
              "name": "symbols",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Comma-separated list of currency codes to limit the response",
                "en": "Comma-separated list of currency codes to limit the response"
              }
            }
          ],
          "responseExample": {
            "amount": 1,
            "base": "EUR",
            "date": "2026-01-23",
            "rates": {
              "USD": 1.0445,
              "GBP": 0.8342,
              "JPY": 161.23,
              "CHF": 0.9234,
              "AUD": 1.6111
            }
          }
        },
        {
          "slug": "get-time-series-rates",
          "operationId": "getTimeSeriesRates",
          "tag": "Exchange Rates",
          "method": "GET",
          "path": "/{start_date}..{end_date}",
          "title": {
            "zh": "获取汇率时间序列",
            "en": "Get time series of exchange rates"
          },
          "description": {
            "zh": "返回指定日期区间内的汇率变化。",
            "en": "Retrieves exchange rates for a date range, returning daily rates between the start and end dates (inclusive).\nIf end_date is omitted, returns all rates from start_date to the latest available date.\n"
          },
          "parameters": [
            {
              "name": "start_date",
              "in": "path",
              "required": true,
              "type": "string",
              "description": {
                "zh": "Start date in ISO 8601 format (YYYY-MM-DD)",
                "en": "Start date in ISO 8601 format (YYYY-MM-DD)"
              },
              "example": "2024-01-01"
            },
            {
              "name": "end_date",
              "in": "path",
              "type": "string",
              "description": {
                "zh": "End date in ISO 8601 format (YYYY-MM-DD).\nCan be omitted by using format \"start_date..\" to get all rates from start_date onwards.\n",
                "en": "End date in ISO 8601 format (YYYY-MM-DD).\nCan be omitted by using format \"start_date..\" to get all rates from start_date onwards.\n"
              },
              "example": "2024-01-31"
            },
            {
              "name": "amount",
              "in": "query",
              "type": "number",
              "description": {
                "zh": "The amount to be converted (default is 1)",
                "en": "The amount to be converted (default is 1)"
              },
              "example": 1
            },
            {
              "name": "base",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Base currency code (three-letter ISO 4217 code)",
                "en": "Base currency code (three-letter ISO 4217 code)"
              },
              "example": "EUR"
            },
            {
              "name": "symbols",
              "in": "query",
              "type": "string",
              "description": {
                "zh": "Comma-separated list of currency codes to limit the response",
                "en": "Comma-separated list of currency codes to limit the response"
              }
            }
          ],
          "responseExample": {
            "amount": 1,
            "base": "EUR",
            "start_date": "2024-01-01",
            "end_date": "2024-01-31",
            "rates": {
              "2024-01-01": {
                "USD": 1.1047,
                "GBP": 0.8692
              },
              "2024-01-02": {
                "USD": 1.1023,
                "GBP": 0.8671
              }
            }
          }
        },
        {
          "slug": "get-currencies",
          "operationId": "getCurrencies",
          "tag": "Currencies",
          "method": "GET",
          "path": "/currencies",
          "title": {
            "zh": "获取支持的货币",
            "en": "Get list of supported currencies"
          },
          "description": {
            "zh": "返回可用于汇率查询的货币代码与名称。",
            "en": "Returns a list of all currency codes supported by the API along with their full names.\nThis endpoint requires no parameters.\n"
          },
          "parameters": [],
          "responseExample": {
            "EUR": "Euro",
            "USD": "United States Dollar",
            "GBP": "British Pound",
            "JPY": "Japanese Yen",
            "AUD": "Australian Dollar"
          }
        }
      ]
    },
    {
