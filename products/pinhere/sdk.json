{
  "formatVersion": 1,
  "package": {
    "name": "@pontx/pinhere",
    "version": "0.1.0",
    "status": "planned",
    "repository": "https://github.com/pontjs/pinhere"
  },
  "cli": {
    "name": "pontx-pinhere"
  },
  "contract": {
    "client": {
      "kind": "factory",
      "factory": "createPinhereClient",
      "identifier": "client",
      "options": {
        "accessToken": "PINHERE_ACCESS_TOKEN",
        "sessionCookie": "PINHERE_SESSION_COOKIE"
      }
    },
    "controllers": {
      "projects": "projects",
      "issues": "issues",
      "attachments": "attachments",
      "webhooks": "webhooks",
      "tokens": "tokens",
      "oauth": "oauth"
    }
  },
  "examples": {
    "typescript": "import { createPinhereClient } from \"@pontx/pinhere\";\n\nconst client = createPinhereClient({\n  accessToken: process.env.PINHERE_ACCESS_TOKEN\n});\nconst issues = await client.issues.listIssues({\n  projectId: \"prj_example\",\n  status: \"open\"\n});",
    "cli": "pnpm add --global @pontx/pinhere\n\npontx-pinhere call issues getIssue --issueId iss_example --dry-run"
  },
  "coverage": {
    "mode": "full"
  },
  "spec": {
    "path": "products/pinhere/spec.pontx.json",
    "sha256": "2a5f9d5796eefc683428b72d676dedc75f85e02b7b97f8de8c7942e66256ab5f"
  }
}
