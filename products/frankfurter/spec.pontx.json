{
  "pontx": "2.1",
  "style": "RESTFul",
  "components": {
    "schemas": {
      "ExchangeRateResponse": {
        "title": "汇率响应",
        "type": "object",
        "description": "指定日期的汇率与换算金额。",
        "required": [
          "amount",
          "base",
          "date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "用于换算的金额",
            "minimum": 0,
            "exclusiveMinimum": 0,
            "examples": [
              1
            ]
          },
          "base": {
            "type": "string",
            "description": "基准货币代码（ISO 4217）",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "EUR"
            ]
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 格式的汇率日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "examples": [
              "2026-01-23"
            ]
          },
          "rates": {
            "type": "object",
            "description": "以键值对表示的汇率（货币代码对应汇率）",
            "additionalProperties": {
              "type": "number",
              "format": "double",
              "description": "货币代码对应的汇率值",
              "examples": [
                1.91
              ]
            },
            "examples": [
              {
                "USD": 1.0445,
                "GBP": 0.8342,
                "JPY": 161.23,
                "CHF": 0.9234,
                "AUD": 1.6111
              }
            ]
          }
        }
      },
      "TimeSeriesResponse": {
        "title": "汇率时间序列响应",
        "type": "object",
        "description": "指定日期区间内的每日汇率集合。",
        "required": [
          "amount",
          "base",
          "start_date",
          "end_date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "用于换算的金额",
            "minimum": 0,
            "examples": [
              1
            ]
          },
          "base": {
            "type": "string",
            "description": "基准货币代码（ISO 4217）",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "EUR"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "时间序列的起始日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "examples": [
              "2023-12-29"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "时间序列的结束日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "examples": [
              "2024-01-31"
            ]
          },
          "rates": {
            "type": "object",
            "description": "按日期组织的汇率",
            "additionalProperties": {
              "type": "object",
              "description": "指定日期的汇率",
              "additionalProperties": {
                "type": "number",
                "format": "double",
                "description": "指定日期下货币代码对应的汇率值",
                "examples": [
                  1.91
                ]
              }
            },
            "examples": [
              {
                "2024-01-01": {
                  "USD": 1.1047,
                  "GBP": 0.8692
                },
                "2024-01-02": {
                  "USD": 1.1023,
                  "GBP": 0.8671
                }
              }
            ]
          }
        }
      },
      "CurrenciesResponse": {
        "title": "货币列表响应",
        "type": "object",
        "description": "货币代码与货币名称的映射。",
        "additionalProperties": {
          "type": "string",
          "description": "货币的完整名称",
          "examples": [
            "Australian Dollar"
          ]
        },
        "examples": [
          {
            "EUR": "Euro",
            "USD": "United States Dollar",
            "GBP": "British Pound",
            "JPY": "Japanese Yen",
            "AUD": "Australian Dollar"
          }
        ]
      },
      "Error": {
        "title": "错误响应",
        "type": "object",
        "description": "接口未找到汇率数据时返回的错误消息。",
        "properties": {
          "message": {
            "type": "string",
            "description": "服务返回的错误消息",
            "examples": [
              "not found"
            ]
          }
        }
      }
    },
    "parameters": {
      "AmountParam": {
        "name": "amount",
        "in": "query",
        "description": "要换算的金额（默认为 1）",
        "required": false,
        "schema": {
          "type": "number",
          "format": "double",
          "default": 1,
          "minimum": 0,
          "exclusiveMinimum": true,
          "example": 1
        }
      },
      "BaseParam": {
        "name": "base",
        "in": "query",
        "description": "基准货币代码（三位 ISO 4217 代码）",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "EUR",
          "example": "EUR"
        }
      },
      "SymbolsParam": {
        "name": "symbols",
        "in": "query",
        "description": "以逗号分隔的货币代码列表，用于限制响应范围",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
        },
        "style": "form",
        "explode": false
      }
    }
  },
  "apis": {
    "exchangeRates/getLatestRates": {
      "summary": "获取最新汇率",
      "operationId": "getLatestRates",
      "consumes": [],
      "description": "返回最近一个有效参考日的汇率。",
      "tags": [
        "Exchange Rates"
      ],
      "method": "GET",
      "path": "/latest",
      "responses": {
        "200": {
          "description": "成功返回汇率",
          "schema": {
            "$ref": "#/components/schemas/ExchangeRateResponse"
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRateResponse"
              },
              "examples": {
                "default": {
                  "summary": "默认以 EUR 为基准的最新汇率",
                  "value": {
                    "amount": 1,
                    "base": "EUR",
                    "date": "2026-01-23",
                    "rates": {
                      "USD": 1.1742,
                      "GBP": 0.8681,
                      "JPY": 185.71
                    }
                  }
                },
                "customAmount": {
                  "summary": "将 100 EUR 换算为 USD 和 GBP",
                  "value": {
                    "amount": 100,
                    "base": "EUR",
                    "date": "2026-01-23",
                    "rates": {
                      "USD": 117.42,
                      "GBP": 86.81
                    }
                  }
                },
                "differentBase": {
                  "summary": "以 USD 为基准的最新汇率",
                  "value": {
                    "amount": 1,
                    "base": "USD",
                    "date": "2026-01-23",
                    "rates": {
                      "EUR": 0.85164,
                      "GBP": 0.73931,
                      "JPY": 158.16
                    }
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "未找到汇率，例如指定的货币不受支持",
          "schema": {
            "$ref": "#/components/schemas/Error"
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              },
              "examples": {
                "invalidCurrency": {
                  "summary": "无效的货币代码",
                  "value": {
                    "message": "not found"
                  }
                }
              }
            }
          }
        },
        "422": {
          "description": "无法处理查询参数，例如金额为零、负数或非数字",
          "schema": {
            "$ref": "#/components/schemas/Error"
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              },
              "example": {
                "message": "invalid amount"
              }
            }
          }
        }
      },
      "deprecated": true,
      "parameters": [
        {
          "in": "query",
          "name": "amount",
          "required": false,
          "schema": {
            "description": "要换算的金额（默认为 1）",
            "type": "number",
            "format": "double",
            "default": 1,
            "minimum": 0,
            "exclusiveMinimum": 0,
            "examples": [
              100
            ]
          }
        },
        {
          "in": "query",
          "name": "base",
          "required": false,
          "schema": {
            "description": "基准货币代码（三位 ISO 4217 代码）",
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "EUR",
            "enum": [
              "AUD",
              "BRL",
              "CAD",
              "CHF",
              "CNY",
              "CZK",
              "DKK",
              "EUR",
              "GBP",
              "HKD",
              "HUF",
              "IDR",
              "ILS",
              "INR",
              "ISK",
              "JPY",
              "KRW",
              "MXN",
              "MYR",
              "NOK",
              "NZD",
              "PHP",
              "PLN",
              "RON",
              "SEK",
              "SGD",
              "THB",
              "TRY",
              "USD",
              "ZAR"
            ],
            "examples": [
              "USD"
            ]
          }
        },
        {
          "in": "query",
          "name": "symbols",
          "required": false,
          "schema": {
            "description": "以逗号分隔的货币代码列表，用于限制响应范围。\n如未指定，则返回所有可用货币。\n",
            "style": "form",
            "explode": false,
            "type": "string",
            "pattern": "^[A-Z]{3}(,[A-Z]{3})*$",
            "examples": [
              "USD,GBP,JPY"
            ]
          }
        }
      ],
      "produces": [
        "application/json"
      ],
      "requestExamples": {
        "default": {
          "request": {
            "path": {},
            "query": {
              "amount": 100,
              "base": "USD"
            },
            "headers": {}
          },
          "expectedStatus": "200"
        }
      }
    },
