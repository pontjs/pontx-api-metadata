      "parameters": [
        {
          "in": "path",
          "name": "start_date",
          "required": true,
          "schema": {
            "description": "ISO 8601 格式的起始日期（YYYY-MM-DD）",
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "examples": [
              "2024-01-01"
            ]
          }
        },
        {
          "in": "path",
          "name": "end_date",
          "required": true,
          "schema": {
            "description": "ISO 8601 格式的结束日期（YYYY-MM-DD）。\n可使用 \"start_date..\" 格式省略结束日期，以获取从 start_date 起的所有汇率。\n",
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "examples": [
              "2024-01-31"
            ]
          }
        },
        {
          "in": "query",
          "name": "amount",
          "required": false,
          "schema": {
            "description": "要换算的金额（默认为 1）",
            "type": "number",
            "format": "double",
            "default": 1,
            "minimum": 0,
            "exclusiveMinimum": 0,
            "examples": [
              1
            ]
          }
        },
        {
          "in": "query",
          "name": "base",
          "required": false,
          "schema": {
            "description": "基准货币代码（三位 ISO 4217 代码）",
