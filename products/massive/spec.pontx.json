      "Ticker": {
        "title": "Massive 标的代码",
        "type": "object",
        "description": "Massive 支持的证券或资产代码及其名称、市场、地区、币种、交易所、标识符和活跃状态。",
        "required": [
          "ticker",
          "name"
        ],
        "properties": {
          "active": {
            "type": "boolean",
            "description": "该资产在查询日期是否处于活跃交易状态。",
            "examples": [
              true
            ]
          },
          "base_currency_name": {
            "type": "string",
            "description": "此资产计价所对应货币的名称。"
          },
          "base_currency_symbol": {
            "type": "string",
            "description": "计价对象货币的 ISO 4217 代码。"
          },
          "cik": {
            "type": "string",
            "description": "此股票代码的 CIK 编号。",
            "examples": [
              "0001090872"
            ]
          },
          "composite_figi": {
            "type": "string",
            "description": "此股票代码的复合 OpenFIGI 编号。",
