{
  "pontx": "2.1",
  "style": "RESTFul",
  "components": {
    "schemas": {
      "ErrorResponse": {
        "title": "Massive 错误响应",
        "type": "object",
        "description": "Massive 因认证、授权、参数、限流或服务问题无法完成请求时返回的错误信息。",
        "properties": {
          "status": {
            "type": "string",
            "description": "机器可读的请求状态。",
            "examples": [
              "ERROR"
            ]
          },
          "error": {
            "type": "string",
            "description": "简短的错误类别或消息。",
            "examples": [
              "API Key was not provided"
            ]
          },
          "message": {
            "type": "string",
            "description": "额外的用户可读错误详情。"
          },
          "request_id": {
            "type": "string",
            "description": "由服务器分配的请求标识符，用于支持和诊断。"
          }
        },
        "additionalProperties": true
      },
      "AggregateBar": {
        "title": "OHLC 聚合行情柱",
        "type": "object",
        "description": "由一个时间窗口内符合条件的成交构建的开盘、最高、最低、收盘、成交量与成交笔数行情柱。",
        "required": [
          "c",
          "h",
          "l",
          "o",
          "t",
          "v"
        ],
        "properties": {
          "T": {
            "type": "string",
            "description": "交易所股票代码；通常出现在上一交易日响应中。",
            "examples": [
              "AAPL"
            ]
          },
          "c": {
            "type": "number",
            "description": "收盘价。",
            "examples": [
              115.97
            ]
          },
          "h": {
            "type": "number",
            "description": "最高价。",
            "examples": [
              117.59
            ]
          },
          "l": {
            "type": "number",
            "description": "最低价。",
            "examples": [
              114.13
            ]
          },
          "n": {
            "type": "integer",
            "description": "聚合时间窗口内的成交笔数。",
            "examples": [
              2
            ]
          },
          "o": {
            "type": "number",
            "description": "开盘价。",
            "examples": [
              115.55
            ]
          },
          "otc": {
            "type": "boolean",
            "description": "场外交易（OTC）聚合行情时为 true；为 false 时省略。"
          },
          "t": {
            "type": "integer",
            "format": "int64",
            "description": "以毫秒级 Unix 时间戳表示的时间窗口起始时间。",
            "examples": [
              1605042000000
            ]
          },
          "v": {
            "type": "number",
            "description": "成交量。",
            "examples": [
              131704427
            ]
          },
          "vw": {
            "type": "number",
            "description": "成交量加权平均价。",
            "examples": [
              116.3058
            ]
          }
        },
        "additionalProperties": true
      },
      "AggregateResponse": {
        "title": "聚合行情响应",
        "type": "object",
        "description": "包含股票代码、复权标记、查询及结果数量、OHLC 行情柱，并可携带下一页地址的响应。",
        "required": [
          "ticker",
          "queryCount",
          "resultsCount",
          "status"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "description": "交易所股票代码。",
            "examples": [
              "AAPL"
            ]
          },
          "adjusted": {
            "type": "boolean",
            "description": "价格是否按股票拆分进行复权。",
            "examples": [
              true
            ]
          },
          "queryCount": {
            "type": "integer",
            "description": "查询的分钟级或日级基础聚合记录数量。",
            "examples": [
              1
            ]
          },
          "request_id": {
            "type": "string",
            "description": "由服务器分配的请求标识符。",
            "examples": [
              "6a7e466379af0a71039d60cc78e72282"
            ]
          },
          "resultsCount": {
            "type": "integer",
            "description": "返回的结果行情柱数量。",
            "examples": [
              1
            ]
          },
          "status": {
            "type": "string",
            "description": "请求状态。",
            "examples": [
              "OK"
            ]
          },
          "results": {
            "type": "array",
            "description": "包含所请求数据的结果数组。",
            "items": {
              "$ref": "#/components/schemas/AggregateBar"
            }
          },
          "next_url": {
            "type": "string",
            "format": "uri",
            "description": "下一页的绝对 URL（如有）。仍可能需要提供身份验证信息。",
            "examples": [
              "https://api.massive.com/v2/aggs/ticker/AAPL/range/1/day/1578114000000/2020-01-10?cursor=bGltaXQ9MiZzb3J0PWFzYw"
            ]
          }
        },
        "additionalProperties": true
      },
      "LastTrade": {
        "title": "最新成交记录",
        "type": "object",
        "description": "Massive 行情源中的最新股票成交，包含价格、股数、交易所、成交条件、序列号和纳秒时间戳。",
        "required": [
          "T",
          "ds",
          "i",
          "p",
          "q",
          "t",
          "x",
          "y"
        ],
        "properties": {
          "T": {
            "type": "string",
            "description": "交易所股票代码。",
            "examples": [
              "AAPL"
            ]
          },
          "c": {
            "type": "array",
            "description": "成交条件代码。",
            "items": {
              "type": "integer",
              "examples": [
                37
              ]
            },
            "examples": [
              [
                37
              ]
            ]
          },
          "ds": {
            "type": "string",
            "description": "包含小数部分的成交数量，以十进制字符串编码。",
            "examples": [
              "25.0"
            ]
          },
          "e": {
            "type": "integer",
            "description": "成交更正标识。"
          },
          "f": {
            "type": "integer",
            "format": "int64",
            "description": "以纳秒级 Unix 时间戳表示的交易报告设施（TRF）接收时间。",
            "examples": [
              1617901342969796400
            ]
          },
          "i": {
            "type": "string",
            "description": "成交标识符，在每个股票代码、交易所与 TRF 组合中唯一。",
            "examples": [
              "118749"
            ]
          },
          "p": {
            "type": "number",
            "description": "每整股价格。",
            "examples": [
              129.8473
            ]
          },
          "q": {
            "type": "integer",
            "format": "int64",
            "description": "该股票代码递增的事件序列号；序列中可能存在间隔。",
            "examples": [
              3135876
            ]
          },
          "r": {
            "type": "integer",
            "description": "交易报告设施（TRF）标识符。",
            "examples": [
              202
            ]
          },
          "s": {
            "type": "number",
            "description": "以股数表示的成交数量。",
            "examples": [
              25
            ]
          },
          "t": {
            "type": "integer",
            "format": "int64",
            "description": "以纳秒级 Unix 时间戳表示的证券信息处理器（SIP）接收时间。",
            "examples": [
              1617901342969834000
            ]
          },
          "x": {
            "type": "integer",
            "description": "交易所标识符；可通过 Massive 交易所参考数据解析。",
            "examples": [
              4
            ]
          },
          "y": {
            "type": "integer",
            "format": "int64",
            "description": "以纳秒级 Unix 时间戳表示的参与方或交易所事件时间。",
            "examples": [
              1617901342968000000
            ]
          },
          "z": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "上市行情带：1=A（NYSE），2=B（NYSE Arca/NYSE American），3=C（Nasdaq）。",
            "examples": [
              3
            ]
          }
        },
        "additionalProperties": true
      },
      "LastTradeResponse": {
        "title": "最新成交响应",
        "type": "object",
        "description": "包含请求标识、状态和最新成交记录的响应。",
        "required": [
          "request_id",
          "status"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "description": "由服务器分配的请求标识符。",
            "examples": [
              "f05562305bd26ced64b98ed68b3c5d96"
            ]
          },
          "results": {
            "$ref": "#/components/schemas/LastTrade"
          },
          "status": {
            "type": "string",
            "description": "请求状态。",
            "examples": [
              "OK"
            ]
          }
        },
        "additionalProperties": true
      },
