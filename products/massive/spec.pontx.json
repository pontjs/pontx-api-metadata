      "UnifiedSnapshot": {
        "title": "统一市场快照",
        "type": "object",
        "description": "股票、期权、外汇、加密货币或指数的统一快照；可包含交易时段、最新报价、最新成交、分钟行情及受套餐限制的 FMV。",
        "required": [
          "ticker"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "description": "资产的股票代码符号。",
            "examples": [
              "NVDA"
            ]
          },
          "name": {
            "type": "string",
            "description": "合约名称。",
            "examples": [
              "Nvidia Corp"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "crypto",
              "fx",
              "indices",
              "options",
              "stocks"
            ],
            "description": "此股票代码的资产类别。",
            "examples": [
              "stocks"
            ]
          },
          "market_status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "early_trading",
              "regular_trading",
              "late_trading"
            ],
            "description": "交易此股票代码的市场状态。股票、期权、加密货币和外汇快照的可能值为 open、closed、early_trading 或 late_trading；指数快照的可能值为 regular_trading、closed、early_trading 和 late_trading。",
            "examples": [
              "closed"
            ]
          },
          "error": {
            "type": "string",
            "description": "此股票代码对应的错误类别。",
            "examples": [
              "NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "description": "此股票代码对应的错误详情。",
            "examples": [
              "Ticker not found."
            ]
          },
          "fmv": {
            "type": "number",
            "description": "Massive 公允市场价值（FMV）；仅限符合条件的 Business 订阅方案。",
            "examples": [
              0.05
            ]
          },
          "fmv_last_updated": {
            "type": "integer",
            "format": "int64",
            "description": "以纳秒级 Unix 时间戳表示的 FMV 计算时间。",
            "examples": [
              1636573458757383400
            ]
          },
          "session": {
            "$ref": "#/components/schemas/SnapshotSession"
          },
          "last_quote": {
            "$ref": "#/components/schemas/SnapshotQuote"
          },
          "last_trade": {
            "$ref": "#/components/schemas/SnapshotTrade"
          },
          "last_minute": {
            "$ref": "#/components/schemas/SnapshotMinuteBar"
          }
        },
        "additionalProperties": true
      },
      "UnifiedSnapshotResponse": {
        "title": "统一市场快照响应",
        "type": "object",
        "description": "包含跨资产快照列表、请求状态和可选下一页地址的分页响应。",
