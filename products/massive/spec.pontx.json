      "path": "/v2/aggs/ticker/{stocksTicker}/range/{multiplier}/{timespan}/{from}/{to}",
      "responses": {
        "200": {
          "description": "成功响应",
          "schema": {
            "$ref": "#/components/schemas/AggregateResponse"
          },
          "content": {
