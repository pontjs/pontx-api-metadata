          "schema": {
            "description": "`YYYY-MM-DD` 格式的结束日期或毫秒级 Unix 时间戳。",
            "type": "string",
            "examples": [
              "2025-01-31"
            ]
          }
        },
        {
          "in": "query",
          "name": "adjusted",
          "required": false,
          "schema": {
            "description": "结果是否按股票拆分进行复权。",
