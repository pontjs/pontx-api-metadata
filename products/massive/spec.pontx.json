                "$ref": "#/components/schemas/AggregateResponse"
              }
            }
          }
        },
        "default": {
          "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "stocksTicker",
          "required": true,
          "schema": {
            "description": "区分大小写的股票代码，例如 `AAPL`。",
            "type": "string",
            "examples": [
              "AAPL"
            ]
          }
        },
        {
          "in": "path",
          "name": "multiplier",
          "required": true,
          "schema": {
            "description": "时间跨度倍数",
            "type": "integer",
            "minimum": 1,
            "examples": [
              1
            ]
          }
        },
        {
          "in": "path",
          "name": "timespan",
          "required": true,
          "schema": {
            "description": "行情柱时间单位",
            "type": "string",
            "enum": [
              "minute",
              "hour",
              "day",
              "week",
              "month",
              "quarter",
              "year"
            ],
            "examples": [
              "minute"
            ]
          }
        },
        {
          "in": "path",
          "name": "from",
          "required": true,
          "schema": {
            "description": "`YYYY-MM-DD` 格式的起始日期或毫秒级 Unix 时间戳。",
            "type": "string",
            "examples": [
