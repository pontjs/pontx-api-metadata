          },
          "market": {
            "type": "string",
            "enum": [
              "crypto",
              "fx",
              "indices",
              "otc",
              "stocks"
            ],
            "description": "资产的市场类型。",
            "examples": [
              "stocks"
            ]
          },
          "name": {
            "type": "string",
            "description": "资产名称。对于股票/权益证券，这是公司的注册名称；对于加密货币/外汇，这是货币或币对名称。",
            "examples": [
              "Agilent Technologies Inc."
            ]
          },
          "primary_exchange": {
            "type": "string",
            "description": "主要交易所的 ISO 10383 市场标识码（MIC）。",
            "examples": [
              "XNYS"
            ]
          },
          "share_class_figi": {
            "type": "string",
            "description": "此股票代码的股类 OpenFIGI 编号。",
            "examples": [
              "BBG001SCTQY4"
            ]
          },
          "ticker": {
            "type": "string",
