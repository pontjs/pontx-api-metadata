          },
          "delisted_utc": {
            "type": "string",
            "format": "date-time",
            "description": "此资产最后交易的日期。"
          },
          "last_updated_utc": {
            "type": "string",
            "format": "date-time",
            "description": "这些信息准确截至此时间。",
            "examples": [
              "2021-04-25T00:00:00Z"
