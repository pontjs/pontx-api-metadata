            "default": true,
            "examples": [
              true
            ]
          }
        },
        {
          "in": "query",
          "name": "sort",
          "required": false,
          "schema": {
            "description": "按行情柱的起始时间戳排序。",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "asc",
            "examples": [
              "asc"
            ]
          }
        },
        {
          "in": "query",
          "name": "limit",
          "required": false,
          "schema": {
            "description": "为构建结果而查询的基础聚合记录的最大数量。",
            "type": "integer",
            "minimum": 1,
            "maximum": 50000,
            "default": 5000,
            "examples": [
