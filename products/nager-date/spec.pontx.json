              "countryCode": "US"
            },
            "query": {}
          },
          "serverUrl": "https://nagerholidays.com",
          "summary": "可复现的只读请求",
          "verifiedAt": "2026-08-15"
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
