          "disabledReason": "Nager.Date Community API 条款限制其用途，商业使用需要有效赞助；Pontx Hub 不代理、缓存或聚合节假日数据。请由调用方在确认自身许可后使用本地 SDK 或 CLI 直连。",
          "enabled": false
        }
      },
      "method": "GET",
      "operationId": "isTodayHoliday",
      "parameters": [
        {
          "in": "path",
          "name": "isoCode",
          "required": true,
          "schema": {
            "default": "us",
            "description": "ISO 3166-1 alpha-2 国家代码，或 ISO 3166-2 行政区代码。",
            "examples": [
