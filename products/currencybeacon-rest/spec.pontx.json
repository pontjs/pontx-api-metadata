{
  "apis": {
    "convertCurrency": {
      "consumes": [],
      "description": "使用当前或指定历史日期的汇率换算金额。",
      "metadata": {
        "documentation": {
          "evidence": [
            "https://currencybeacon.com/api-documentation",
            "https://currencybeacon.com/code-samples"
          ],
          "status": "official",
          "verifiedAt": "2026-08-15"
        }
      },
      "method": "GET",
      "operationId": "convertCurrency",
      "parameters": [
        {
          "in": "query",
          "name": "from",
          "required": true,
          "schema": {
            "description": "待换算货币的三字母代码。",
            "examples": [
              "USD"
            ],
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "to",
          "required": true,
          "schema": {
            "description": "目标货币的三字母代码。",
            "examples": [
              "USD"
            ],
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "amount",
          "required": true,
          "schema": {
            "description": "待换算的金额。",
            "examples": [
              10
            ],
            "minimum": 0,
            "type": "number"
          }
        },
        {
          "in": "query",
          "name": "date",
          "required": false,
          "schema": {
            "description": "历史查询或换算使用的日期，格式为 YYYY-MM-DD。",
            "examples": [
              "2025-01-02"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          }
        }
      ],
      "path": "/convert",
      "produces": [
        "application/json"
      ],
      "requestExamples": {
        "default": {
          "expectedStatus": "200",
          "request": {
            "headers": {},
            "query": {
              "amount": 10,
              "from": "USD",
              "to": "EUR"
            }
          },
          "serverUrl": "https://api.currencybeacon.com/v1",
          "summary": "可复现的只读请求",
          "verifiedAt": "2026-08-15"
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversionResponse"
              }
            }
          },
          "description": "请求成功，返回该 Endpoint 定义的 JSON 响应。"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "请求参数无效。"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "调用方凭据缺失、无效或尚未激活。"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "调用方套餐或权限不允许此请求。"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "请求的 Endpoint 或资源不存在。"
        },
        "429": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "调用方超过服务调用额度或速率限制。"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "上游服务发生内部错误。"
        }
      },
      "summary": "换算货币金额",
      "tags": []
    },
    "getHistoricalRates": {
      "consumes": [],
      "description": "返回指定日期的历史汇率，可按 symbols 限制返回货币。",
      "metadata": {
        "documentation": {
          "evidence": [
            "https://currencybeacon.com/api-documentation",
            "https://currencybeacon.com/code-samples"
          ],
          "status": "official",
          "verifiedAt": "2026-08-15"
        }
      },
      "method": "GET",
      "operationId": "getHistoricalRates",
      "parameters": [
        {
          "in": "query",
          "name": "date",
          "required": true,
          "schema": {
            "description": "历史查询或换算使用的日期，格式为 YYYY-MM-DD。",
            "examples": [
              "2025-01-02"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "base",
          "required": false,
          "schema": {
            "description": "基准货币的三字母代码；未提供时服务默认使用 USD。",
            "examples": [
              "USD"
            ],
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "symbols",
          "required": false,
          "schema": {
            "description": "可选的逗号分隔货币代码列表，用于限制返回汇率。",
            "examples": [
              "EUR,GBP"
            ],
            "pattern": "^[A-Za-z0-9]+(?:,[A-Za-z0-9]+)*$",
            "type": "string"
          }
        }
      ],
      "path": "/historical",
      "produces": [
        "application/json"
      ],
      "requestExamples": {
        "default": {
          "expectedStatus": "200",
          "request": {
            "headers": {},
            "query": {
              "base": "USD",
              "date": "2025-01-02",
              "symbols": "EUR,GBP"
            }
          },
          "serverUrl": "https://api.currencybeacon.com/v1",
          "summary": "可复现的只读请求",
          "verifiedAt": "2026-08-15"
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoricalRatesResponse"
