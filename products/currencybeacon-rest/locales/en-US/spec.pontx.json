{
  "apis": {
    "convertCurrency": {
      "consumes": [],
      "description": "Converts an amount using current rates or rates for a specified historical date.",
      "metadata": {
        "documentation": {
          "evidence": [
            "https://currencybeacon.com/api-documentation",
            "https://currencybeacon.com/code-samples"
          ],
          "status": "official",
          "verifiedAt": "2026-08-15"
        }
      },
      "method": "GET",
      "operationId": "convertCurrency",
      "parameters": [
        {
          "in": "query",
          "name": "from",
          "required": true,
          "schema": {
            "description": "Three-letter code of the currency to convert from.",
            "examples": [
              "USD"
            ],
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "to",
          "required": true,
          "schema": {
            "description": "Three-letter code of the target currency.",
            "examples": [
              "USD"
            ],
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "amount",
          "required": true,
          "schema": {
            "description": "Amount to convert.",
            "examples": [
              10
            ],
            "minimum": 0,
            "type": "number"
          }
        },
        {
          "in": "query",
          "name": "date",
          "required": false,
          "schema": {
            "description": "Date used for a historical lookup or conversion, in YYYY-MM-DD format.",
            "examples": [
              "2025-01-02"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          }
        }
      ],
      "path": "/convert",
      "produces": [
        "application/json"
      ],
      "requestExamples": {
        "default": {
          "expectedStatus": "200",
          "request": {
            "headers": {},
            "query": {
              "amount": 10,
              "from": "USD",
              "to": "EUR"
            }
          },
          "serverUrl": "https://api.currencybeacon.com/v1",
          "summary": "Reproducible read-only request",
          "verifiedAt": "2026-08-15"
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversionResponse"
              }
            }
          },
          "description": "Request succeeded and returns this Endpoint's JSON response."
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The request parameters are invalid."
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The caller credential is missing, invalid, or not activated."
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The caller plan or permission does not allow this request."
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The requested Endpoint or resource does not exist."
        },
        "429": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The caller exceeded a service quota or rate limit."
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "The upstream service encountered an internal error."
        }
      },
      "summary": "Convert a currency amount",
      "tags": []
    },
    "getHistoricalRates": {
      "consumes": [],
