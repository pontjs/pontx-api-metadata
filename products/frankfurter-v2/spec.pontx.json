{
  "pontx": "2.1",
  "style": "RESTFul",
  "components": {
    "parameters": {
      "date": {
        "name": "date",
        "in": "query",
        "description": "指定日期（YYYY-MM-DD），不能与 from/to 同时使用。",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2024-01-15"
        }
      },
      "from": {
        "name": "from",
        "in": "query",
        "description": "日期区间起点（YYYY-MM-DD）",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2024-01-01"
        }
      },
      "to": {
        "name": "to",
        "in": "query",
        "description": "日期区间终点（YYYY-MM-DD），默认为今天。",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2024-01-31"
        }
      },
      "base": {
        "name": "base",
        "in": "query",
        "description": "基准货币，默认为 EUR",
        "required": false,
        "schema": {
          "type": "string",
          "default": "EUR",
          "example": "USD"
        }
      },
      "quotes": {
        "name": "quotes",
        "in": "query",
        "description": "要包含的计价货币代码，以逗号分隔",
        "required": false,
        "schema": {
          "type": "string",
          "example": "USD,GBP,JPY"
        }
      },
      "providers": {
        "name": "providers",
        "in": "query",
        "description": "要包含的数据提供方代码，以逗号分隔",
        "required": false,
        "schema": {
          "type": "string",
          "example": "ECB,TCMB"
        }
      },
      "group": {
        "name": "group",
        "in": "query",
        "description": "按时间周期对汇率降采样，仅适用于日期区间。",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "week",
            "month"
          ],
          "x-enum-descriptions": [
            "按周",
            "按月"
          ],
          "example": "month"
        }
      },
      "expand": {
        "name": "expand",
        "in": "query",
        "description": "每条记录要展开的可选字段，以逗号分隔。目前支持 `providers`：为每条记录增加 `{ key, date, rate }` 对象数组，展示各提供方的观测日期与汇率。因共识过滤被判为异常值，或因货币锚定关系而被覆盖的提供方，会标记 `excluded: true`。若锚定货币记录由系统合成且没有提供方直接发布该计价货币，则省略此字段。CSV 输出中，`providers` 列使用 `|` 连接 `KEY:RATE`，被排除的条目末尾附加 `*`（例如 `ECB:0.92|FED:1.50*`）。",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "providers"
          ],
          "x-enum-descriptions": [
            "展开各数据提供方汇率"
          ],
          "example": "providers"
        }
      }
    },
    "schemas": {
      "Rate": {
        "title": "汇率记录",
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "汇率日期",
            "examples": [
              "2024-01-15"
            ]
          },
          "base": {
            "type": "string",
            "description": "基准货币代码",
            "examples": [
              "EUR"
            ]
          },
          "quote": {
            "type": "string",
            "description": "计价货币代码",
            "examples": [
              "USD"
            ]
          },
          "rate": {
            "type": "number",
            "description": "汇率数值",
            "exclusiveMinimum": 0,
            "examples": [
              1.089
            ]
          },
          "providers": {
            "type": "array",
            "description": "该货币对按提供方拆分的汇率，仅在设置 `expand=providers` 时出现。每项包含提供方的观测日期，以及换算到当前记录基准货币后的发布汇率。标记 `excluded: true` 的条目未参与混合 `rate`，原因可能是被共识过滤判为异常值，或被货币锚定关系覆盖。若锚定货币记录由系统合成且没有提供方直接发布该计价货币，则省略此字段。",
            "items": {
              "type": "object",
              "description": "每项包含提供方的观测日期，以及换算到当前记录基准货币后的发布汇率。",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "数据提供方代码",
                  "examples": [
                    "BAM"
                  ]
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "description": "此条目采用的提供方观测日期",
                  "examples": [
                    "2026-08-10"
                  ]
                },
                "rate": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "提供方汇率，已换算到当前记录的基准货币",
                  "examples": [
                    3.6731
                  ]
                },
                "excluded": {
                  "type": "boolean",
                  "description": "此条目未参与混合汇率时出现且值为 true",
                  "examples": [
                    true
                  ]
                }
              },
              "required": [
                "key",
                "date",
                "rate"
              ]
            }
          }
        },
        "required": [
          "date",
          "base",
          "quote",
          "rate"
        ]
      },
      "Currency": {
        "title": "货币摘要",
        "type": "object",
        "properties": {
          "iso_code": {
            "type": "string",
            "description": "ISO 4217 货币代码",
            "examples": [
              "EUR"
            ]
          },
          "iso_numeric": {
            "type": "string",
            "description": "ISO 4217 数字代码",
            "nullable": true,
            "examples": [
              "978"
            ]
          },
          "name": {
            "type": "string",
            "description": "货币完整名称",
            "examples": [
              "Euro"
            ]
          },
          "symbol": {
            "type": "string",
            "description": "货币符号",
            "nullable": true,
            "examples": [
              "€"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "最早可用日期",
            "nullable": true,
            "examples": [
              "1999-01-04"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "最新可用日期",
            "nullable": true,
            "examples": [
              "2026-03-17"
            ]
          }
        },
        "required": [
          "iso_code",
          "name"
        ]
      },
      "CurrencyDetail": {
        "title": "货币详情",
        "type": "object",
        "properties": {
          "iso_code": {
            "type": "string",
            "description": "ISO 4217 货币代码",
            "examples": [
              "USD"
            ]
          },
          "iso_numeric": {
            "type": "string",
            "description": "ISO 4217 数字代码",
            "nullable": true,
            "examples": [
              "840"
            ]
          },
          "name": {
            "type": "string",
            "description": "货币完整名称",
            "examples": [
              "United States Dollar"
            ]
          },
          "symbol": {
            "type": "string",
            "description": "货币符号",
            "nullable": true,
            "examples": [
              "$"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "发布此货币汇率的数据提供方代码",
              "examples": [
                "ECB"
              ]
            },
            "description": "发布此货币汇率的数据提供方代码"
          },
          "peg": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string"
              },
              "rate": {
                "type": "number"
              },
              "authority": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "format": "uri"
              }
            },
            "description": "锚定汇率元数据，仅锚定货币包含此字段"
          }
        },
        "required": [
          "iso_code",
          "name"
        ]
      },
      "Provider": {
        "title": "汇率数据提供方",
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "数据提供方标识",
            "examples": [
              "ECB"
            ]
          },
          "name": {
            "type": "string",
            "description": "数据提供方完整名称",
            "examples": [
              "European Central Bank"
            ]
          },
          "country_code": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 国家或地区代码",
            "nullable": true,
            "examples": [
              "EU"
            ]
          },
          "rate_type": {
            "type": "string",
            "description": "数据源采用的官方汇率类型",
            "nullable": true,
            "examples": [
              "reference"
            ]
          },
          "pivot_currency": {
            "type": "string",
            "description": "提供方发布汇率时采用的基准货币",
            "nullable": true,
            "examples": [
              "EUR"
            ]
          },
          "data_url": {
            "type": "string",
            "format": "uri",
            "description": "原始数据源链接",
            "nullable": true,
            "examples": [
              "https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html"
            ]
          },
          "terms_url": {
            "type": "string",
            "format": "uri",
            "description": "使用条款链接",
            "nullable": true,
            "examples": [
              "https://www.ecb.europa.eu/services/using-our-site/disclaimer/html/index.en.html"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "最早可用日期",
            "nullable": true,
            "examples": [
              "1999-01-04"
            ]
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "最新可用日期",
            "nullable": true,
            "examples": [
              "2026-03-17"
            ]
          },
          "publish_cadence": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "提供方发布汇率的频率，同时决定 publishes_missed 的计量单位：天、ISO 周或自然月。仅提供历史数据且无计划发布频率时为 null。",
            "examples": [
              "daily"
            ]
          },
          "publishes_missed": {
            "type": "integer",
            "minimum": 0,
            "description": "自 end_date 以来缺失的预期发布次数，单位由 publish_cadence 决定。日频提供方统计 end_date 与今天之间应发布的日期；周频和月频提供方统计最近导入周期与已开始发布窗口的周期之间相隔的 ISO 周或自然月。没有计划发布频率或尚无导入数据时为 null。",
            "examples": [
              0
            ],
            "nullable": true
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "此提供方覆盖的货币代码",
              "examples": [
                "USD"
              ]
            },
            "description": "此提供方覆盖的货币代码"
          }
        },
        "required": [
          "key",
          "name",
          "currencies"
        ]
      }
    },
    "responses": {
      "UnprocessableEntity": {
        "description": "请求参数无效",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "请求参数无效",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "未找到数据",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "未找到数据",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "响应计算完成前已超过请求时限。请缩小请求范围后重试：使用 quotes 过滤、使用 group 聚合，或将日期区间拆分为更短的请求。",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "description": "响应计算完成前已超过请求时限。请缩小请求范围后重试：使用 quotes 过滤、使用 group 聚合，或将日期区间拆分为更短的请求。",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "apis": {
    "getRates": {
      "summary": "获取汇率",
      "operationId": "getRates",
      "consumes": [],
      "description": "返回跨数据提供方混合计算的汇率。不传日期参数时返回最新汇率，每条记录代表一个货币对。响应包含基准货币自身的恒等记录（base 与 quote 相同、rate 为 1），且与其他记录一样受 quotes 过滤。接口支持任意长度的日粒度日期区间及完整历史。限制：使用 `providers` 或 `expand=providers` 时会逐日重新计算混合值，日粒度超过 5 年的区间将返回 422；若 `providers` 最多指定 5 个提供方且 `quotes` 最多指定 5 种货币，则不受此限制。不指定 `providers` 时，`expand=providers` 会忽略 `quotes` 对计算量的缩减，因此应使用 `group=week` 或 `group=month` 聚合、指定 `providers`，或拆分日期区间。",
      "tags": [],
      "method": "GET",
      "path": "/rates",
      "responses": {
        "200": {
          "description": "汇率列表",
          "schema": {
            "type": "array",
            "description": "汇率列表",
            "items": {
              "$ref": "#/components/schemas/Rate"
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "description": "汇率列表",
                "items": {
                  "$ref": "#/components/schemas/Rate"
                }
              },
              "example": [
                {
                  "date": "2024-01-15",
                  "base": "EUR",
                  "quote": "EUR",
                  "rate": 1
                },
                {
                  "date": "2024-01-15",
                  "base": "EUR",
                  "quote": "GBP",
                  "rate": 0.8623
                },
                {
                  "date": "2024-01-15",
                  "base": "EUR",
                  "quote": "USD",
                  "rate": 1.089
                }
              ]
            },
            "application/x-ndjson": {
              "schema": {
                "type": "string",
                "description": "Rate 对象的 NDJSON 流，每行一个独立 JSON 对象"
              },
              "example": "{ \"date\": \"2024-01-15\", \"base\": \"EUR\", \"quote\": \"USD\", \"rate\": 1.089 }\n{ \"date\": \"2024-01-15\", \"base\": \"EUR\", \"quote\": \"GBP\", \"rate\": 0.8623 }\n"
            }
          }
        },
        "404": {
          "description": "未找到数据",
          "schema": {
            "type": "object",
            "description": "未找到数据",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "未找到数据",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "422": {
          "description": "请求参数无效",
          "schema": {
            "type": "object",
            "description": "请求参数无效",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "请求参数无效",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "503": {
          "description": "响应计算完成前已超过请求时限。请缩小请求范围后重试：使用 quotes 过滤、使用 group 聚合，或将日期区间拆分为更短的请求。",
          "schema": {
            "type": "object",
            "description": "响应计算完成前已超过请求时限。请缩小请求范围后重试：使用 quotes 过滤、使用 group 聚合，或将日期区间拆分为更短的请求。",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "响应计算完成前已超过请求时限。请缩小请求范围后重试：使用 quotes 过滤、使用 group 聚合，或将日期区间拆分为更短的请求。",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "in": "query",
          "name": "date",
          "required": false,
          "schema": {
            "description": "指定日期（YYYY-MM-DD），不能与 from/to 同时使用。",
            "type": "string",
            "format": "date",
            "examples": [
              "2024-01-15"
            ]
          }
        },
        {
          "in": "query",
          "name": "from",
          "required": false,
          "schema": {
            "description": "日期区间起点（YYYY-MM-DD）",
            "type": "string",
            "format": "date",
            "examples": [
              "2024-01-01"
            ]
          }
        },
        {
          "in": "query",
          "name": "to",
          "required": false,
          "schema": {
            "description": "日期区间终点（YYYY-MM-DD），默认为今天。",
            "type": "string",
            "format": "date",
            "examples": [
              "2024-01-31"
            ]
          }
        },
        {
          "in": "query",
          "name": "base",
          "required": false,
          "schema": {
            "description": "基准货币，默认为 EUR",
            "type": "string",
            "default": "EUR",
            "examples": [
              "USD"
            ]
          }
        },
        {
          "in": "query",
          "name": "quotes",
          "required": false,
          "schema": {
            "description": "要包含的计价货币代码，以逗号分隔",
            "type": "string",
            "examples": [
              "USD,GBP,JPY"
            ]
          }
        },
        {
          "in": "query",
          "name": "providers",
          "required": false,
          "schema": {
            "description": "要包含的数据提供方代码，以逗号分隔",
            "type": "string",
            "examples": [
              "ECB,TCMB"
            ]
          }
        },
        {
          "in": "query",
          "name": "group",
          "required": false,
          "schema": {
            "description": "按时间周期对汇率降采样，仅适用于日期区间。",
            "type": "string",
            "enum": [
              "week",
              "month"
            ],
            "examples": [
              "month"
            ],
            "enumValueTitles": {
              "week": "按周",
              "month": "按月"
            }
          }
        },
        {
          "in": "query",
          "name": "expand",
          "required": false,
          "schema": {
            "description": "每条记录要展开的可选字段，以逗号分隔。目前支持 `providers`：为每条记录增加 `{ key, date, rate }` 对象数组，展示各提供方的观测日期与汇率。因共识过滤被判为异常值，或因货币锚定关系而被覆盖的提供方，会标记 `excluded: true`。若锚定货币记录由系统合成且没有提供方直接发布该计价货币，则省略此字段。CSV 输出中，`providers` 列使用 `|` 连接 `KEY:RATE`，被排除的条目末尾附加 `*`（例如 `ECB:0.92|FED:1.50*`）。",
            "type": "string",
            "enum": [
              "providers"
            ],
            "examples": [
              "providers"
            ],
            "enumValueTitles": {
              "providers": "展开各数据提供方汇率"
            }
          }
        }
      ],
      "produces": [
        "application/json",
        "application/x-ndjson"
      ],
      "requestExamples": {
        "default": {
          "request": {
            "path": {},
            "query": {
              "base": "USD"
            },
            "headers": {}
          },
          "expectedStatus": "200"
        }
      }
    },
    "getRate": {
      "summary": "获取单一货币对汇率",
      "operationId": "getRate",
      "consumes": [],
      "description": "返回单一货币对的混合汇率。不传日期参数时返回最新汇率；相同货币组成的货币对返回值为 1 的恒等汇率。",
      "tags": [],
      "method": "GET",
      "path": "/rate/{base}/{quote}",
      "responses": {
        "200": {
          "description": "单一货币对汇率",
          "schema": {
            "$ref": "#/components/schemas/Rate"
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rate"
              },
              "example": {
                "date": "2026-03-25",
