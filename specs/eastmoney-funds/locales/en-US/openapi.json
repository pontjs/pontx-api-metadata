            "description": "Comma-separated Eastmoney security IDs in `market.code` form; observed market IDs include `1` for Shanghai and `0` for Shenzhen.",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Comma-separated Eastmoney security IDs in `market.code` form; observed market IDs include `1` for Shanghai and `0` for Shenzhen.",
