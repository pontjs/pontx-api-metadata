{
  "openapi": "3.0.3",
  "info": {
    "title": "Eastmoney Fund Web Data API",
    "version": "2026-08-10",
    "description": "Undocumented Eastmoney/Tiantian Fund read-only web endpoints observed on provider-owned fund pages. Wire formats include JSON, a historical JSONP estimate route that currently returns HTML, and provider-internal field identifiers. This is an evidence-labelled web interface, not an official developer API.",
    "license": {
      "name": "Proprietary / undocumented"
    }
  },
  "servers": [
    {
      "url": "https://api.fund.eastmoney.com"
    },
    {
      "url": "https://fundgz.1234567.com.cn"
    },
    {
      "url": "https://push2.eastmoney.com"
    }
  ],
  "paths": {
    "/js/{fundCode}.js": {
      "get": {
        "operationId": "getFundEstimate",
        "summary": "Get latest fund estimate",
        "description": "Historical estimate route whose successful legacy wire format was `jsonpgz({...});`, with string fields such as `fundcode`, `name`, `jzrq` (NAV date), `dwjz` (unit NAV), `gsz` (estimated NAV), `gszzl` (estimated percent change) and `gztime` (estimate time). A read-only verification on 2026-08-10 returned Eastmoney's UTF-8 page-not-found HTML with HTTP 200, so callers must inspect the media type/body and must not assume JSONP.",
        "parameters": [
          {
            "name": "fundCode",
            "in": "path",
            "description": "Six-digit mainland fund code.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{6}$",
              "description": "Six-digit mainland fund code.",
              "example": "001072"
            },
            "example": "001072"
          },
          {
            "name": "rt",
            "in": "query",
            "description": "Cache-busting Unix timestamp in milliseconds; it does not change the represented fund.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "Cache-busting Unix timestamp in milliseconds; it does not change the represented fund.",
              "example": 1770000000000
            },
            "example": 1770000000000
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy JavaScript/JSONP on success; currently an HTTP-200 page-not-found HTML document.",
            "content": {
              "application/javascript": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyFundEstimateJsonp"
                },
                "example": "jsonpgz({\"fundcode\":\"001072\",\"name\":\"...\",\"jzrq\":\"2025-09-02\",\"dwjz\":\"2.6170\",\"gsz\":\"2.6300\",\"gszzl\":\"0.50\",\"gztime\":\"2025-09-03 15:00\"});"
              },
              "text/html": {
                "schema": {
                  "$ref": "#/components/schemas/EastmoneyNotFoundHtml"
                },
                "example": "<!doctype html><html><head><title>页面未找到 - 东方财富网</title>..."
              }
            }
          },
          "default": {
            "description": "Request failed."
          }
        },
        "x-pontx-documentation-status": "observed",
        "x-pontx-evidence": [
          "https://fund.eastmoney.com/001072.html",
          "https://fundgz.1234567.com.cn/js/001072.js"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Used by FiApp historically; provider verification on 2026-08-10 returned Eastmoney's page-not-found HTML instead of JSONP.",
        "servers": [
          {
            "url": "https://fundgz.1234567.com.cn"
          }
        ],
        "x-pontx-proxy-headers": {
          "Referer": "https://fund.eastmoney.com/"
        },
        "x-pontx-proxy-enabled": false,
        "x-pontx-proxy-disabled-reason": "This URL currently returns Eastmoney's page-not-found HTML, so proxy execution is disabled."
      }
    },
    "/f10/lsjz": {
      "get": {
        "operationId": "listHistoricalNav",
        "summary": "List historical fund NAV",
        "description": "Returns paginated historical unit and cumulative NAV rows as JSON. Numeric NAV values and growth rates are encoded as strings. Pagination metadata (`TotalCount`, `PageSize`, `PageIndex`) is at the response root, while `Data.LSJZList` contains rows.",
        "parameters": [
          {
            "name": "fundCode",
            "in": "query",
            "description": "Six-digit mainland fund code.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{6}$",
              "description": "Six-digit mainland fund code.",
              "example": "001072"
            },
            "example": "001072"
          },
          {
            "name": "pageIndex",
            "in": "query",
            "description": "One-based page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "description": "One-based page",
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Rows per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "description": "Rows per page",
              "example": 20
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Inclusive lower date bound in `YYYY-MM-DD`; an empty value means no lower bound.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive lower date bound in `YYYY-MM-DD`; an empty value means no lower bound.",
              "example": "2026-01-23"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Inclusive upper date bound in `YYYY-MM-DD`; an empty value means no upper bound.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive upper date bound in `YYYY-MM-DD`; an empty value means no upper bound.",
              "example": "2026-01-23"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoricalNavResponse"
                },
                "examples": {
                  "populated": {
                    "summary": "Two historical NAV rows",
                    "value": {
                      "Data": {
                        "LSJZList": [
                          {
                            "FSRQ": "2026-08-07",
                            "DWJZ": "4.6050",
                            "LJJZ": "4.6580",
                            "SDATE": null,
                            "ACTUALSYI": "",
                            "NAVTYPE": "1",
                            "JZZZL": "3.58",
                            "SGZT": "开放申购",
                            "SHZT": "开放赎回",
                            "FHFCZ": "",
                            "FHFCZ10": "",
                            "FHFCBZ": "",
                            "DTYPE": null,
                            "FHSP": ""
                          }
                        ],
                        "FundType": "001",
                        "SYType": null,
                        "isNewType": false,
                        "Feature": null
                      },
                      "ErrCode": 0,
                      "ErrMsg": null,
                      "TotalCount": 2723,
                      "Expansion": null,
                      "PageSize": 2,
                      "PageIndex": 1
                    }
                  },
                  "unknownFund": {
                    "summary": "Unknown fund code is represented as a successful empty page, not an HTTP error",
                    "value": {
                      "Data": {
                        "LSJZList": [],
                        "FundType": "",
                        "SYType": null,
                        "isNewType": false,
                        "Feature": null
                      },
                      "ErrCode": 0,
                      "ErrMsg": null,
                      "TotalCount": 0,
                      "Expansion": null,
                      "PageSize": 2,
                      "PageIndex": 1
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request failed."
          }
        },
        "x-pontx-documentation-status": "observed",
        "x-pontx-evidence": [
          "https://fundf10.eastmoney.com/jjjz_001072.html",
          "https://api.fund.eastmoney.com/f10/lsjz?fundCode=001072&pageIndex=1&pageSize=2&startDate=&endDate="
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Read-only JSON request verified on 2026-08-10. Provider field names are abbreviated and undocumented; unknown fields are intentionally preserved.",
        "servers": [
          {
            "url": "https://api.fund.eastmoney.com"
          }
        ],
        "x-pontx-proxy-headers": {
          "Referer": "https://fundf10.eastmoney.com/"
        }
      }
    },
    "/f10/LSJZChart": {
      "get": {
        "operationId": "getHistoricalNavChart",
        "summary": "Get historical NAV chart series",
        "description": "Returns chart points as positional two-element arrays `[Unix epoch milliseconds, unit NAV]`, not objects. The response also includes root-level status and pagination metadata. A 2026-08-10 request showed that `pageSize=3` was ignored and the response reported its effective `PageSize` as 400, so callers should use the returned metadata rather than assuming the request limit is honored.",
        "parameters": [
          {
            "name": "fundCode",
            "in": "query",
            "description": "Six-digit mainland fund code.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{6}$",
              "description": "Six-digit mainland fund code.",
              "example": "001072"
            },
            "example": "001072"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Provider chart-series selector. Only value `0` was observed for unit NAV; other values are undocumented.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "enum": [
                0
              ],
              "description": "Provider chart-series selector. Only value `0` was observed for unit NAV; other values are undocumented.",
              "example": 0,
              "x-enum-descriptions": [
                "Value 0."
              ]
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "description": "One-based page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "description": "One-based page",
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Requested maximum points. The provider may ignore this value and return/report an effective page size of 400.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 400,
              "minimum": 1,
              "description": "Requested maximum points. The provider may ignore this value and return/report an effective page size of 400.",
              "example": 400
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Inclusive lower date bound in `YYYY-MM-DD`; an empty value means the provider default range.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive lower date bound in `YYYY-MM-DD`; an empty value means the provider default range.",
              "example": "2026-01-23"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Inclusive upper date bound in `YYYY-MM-DD`; an empty value means the provider default range.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Inclusive upper date bound in `YYYY-MM-DD`; an empty value means the provider default range.",
              "example": "2026-01-23"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoricalNavChartResponse"
                },
                "example": {
                  "Data": [
                    [
                      1754870400000,
                      2.59
                    ],
                    [
                      1754956800000,
                      2.617
                    ]
                  ],
                  "ErrCode": 0,
                  "ErrMsg": null,
                  "TotalCount": 241,
                  "Expansion": null,
                  "PageSize": 400,
                  "PageIndex": 1
                }
              }
            }
          },
          "default": {
            "description": "Request failed."
          }
        },
        "x-pontx-documentation-status": "observed",
        "x-pontx-evidence": [
          "https://fundf10.eastmoney.com/jjjz_001072.html",
          "https://api.fund.eastmoney.com/f10/LSJZChart?fundCode=001072&type=0&pageIndex=1&pageSize=400&startDate=&endDate="
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Read-only JSON request verified on 2026-08-10. The actual wire format is a two-number tuple, and provider pagination behavior may differ from requested values.",
        "servers": [
