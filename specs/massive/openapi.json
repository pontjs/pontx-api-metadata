  "components": {
    "schemas": {
      "ErrorResponse": {
        "title": "Massive 错误响应",
        "type": "object",
        "description": "Massive 因认证、授权、参数、限流或服务问题无法完成请求时返回的错误信息。",
        "properties": {
          "status": {
            "type": "string",
            "description": "机器可读的请求状态。",
            "example": "ERROR"
          },
          "error": {
            "type": "string",
            "description": "简短的错误类别或消息。",
            "example": "API Key was not provided"
          },
          "message": {
            "type": "string",
            "description": "额外的用户可读错误详情。",
            "example": "Example message"
          },
          "request_id": {
            "type": "string",
            "description": "由服务器分配的请求标识符，用于支持和诊断。",
            "example": "massive-example-id"
          }
        },
        "additionalProperties": true
      },
      "AggregateBar": {
        "title": "OHLC 聚合行情柱",
        "type": "object",
        "description": "由一个时间窗口内符合条件的成交构建的开盘、最高、最低、收盘、成交量与成交笔数行情柱。",
        "required": [
          "c",
          "h",
          "l",
          "o",
          "t",
          "v"
        ],
        "properties": {
          "T": {
            "type": "string",
            "description": "交易所股票代码；通常出现在上一交易日响应中。",
            "example": "AAPL"
          },
          "c": {
            "type": "number",
            "description": "收盘价。",
            "example": 115.97
          },
          "h": {
            "type": "number",
            "description": "最高价。",
            "example": 117.59
          },
          "l": {
            "type": "number",
            "description": "最低价。",
            "example": 114.13
          },
          "n": {
            "type": "integer",
            "description": "聚合时间窗口内的成交笔数。",
            "example": 2
          },
          "o": {
            "type": "number",
            "description": "开盘价。",
            "example": 115.55
          },
          "otc": {
            "type": "boolean",
            "description": "场外交易（OTC）聚合行情时为 true；为 false 时省略。",
            "example": true
          },
          "t": {
            "type": "integer",
            "format": "int64",
            "description": "以毫秒级 Unix 时间戳表示的时间窗口起始时间。",
            "example": 1605042000000
          },
