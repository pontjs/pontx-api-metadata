{
  "openapi": "3.0.3",
  "info": {
    "title": "Massive 股票市场数据 API",
    "version": "2026-08-10",
    "description": "经过整理的只读 Massive 股票市场 REST API，涵盖报价、聚合行情、市场快照和股票代码参考数据。Massive 原名 Polygon.io；接口访问权限、数据时效性和历史数据范围因订阅方案而异。",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.massive.com",
      "description": "Massive 官方生产环境 REST API"
    }
  ],
  "paths": {
    "/v2/last/trade/{stocksTicker}": {
      "get": {
        "operationId": "getLastTrade",
        "summary": "获取最新成交",
        "description": "返回指定股票最近一笔可用成交。",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "区分大小写的股票代码，例如 `AAPL`。",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL",
              "description": "区分大小写的股票代码，例如 `AAPL`。"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LastTradeResponse"
                }
              }
            }
          },
          "default": {
            "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/trades-quotes/last-trade"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "官方文档收录的接口；可用性取决于账户的市场数据订阅方案。"
      }
    },
    "/v2/aggs/ticker/{stocksTicker}/prev": {
      "get": {
        "operationId": "getPreviousClose",
        "summary": "获取前一交易日行情",
        "description": "返回指定股票前一交易日的聚合行情。",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "区分大小写的股票代码，例如 `AAPL`。",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL",
              "description": "区分大小写的股票代码，例如 `AAPL`。"
            }
          },
          {
            "name": "adjusted",
            "in": "query",
            "description": "返回按股票拆分复权后的结果",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "description": "返回按股票拆分复权后的结果",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                }
              }
            }
          },
          "default": {
            "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/aggregates/previous-day-bar"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "官方文档收录的聚合行情接口。"
      }
    },
    "/v2/aggs/ticker/{stocksTicker}/range/{multiplier}/{timespan}/{from}/{to}": {
      "get": {
        "operationId": "getAggregateBars",
        "summary": "获取自定义周期 K 线",
        "description": "按时间范围和周期查询聚合行情。",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "区分大小写的股票代码，例如 `AAPL`。",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL",
              "description": "区分大小写的股票代码，例如 `AAPL`。"
            }
          },
          {
            "name": "multiplier",
            "in": "path",
            "description": "时间跨度倍数",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "时间跨度倍数",
              "example": 1
            }
          },
          {
            "name": "timespan",
            "in": "path",
            "description": "行情柱时间单位",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "minute",
                "hour",
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "description": "行情柱时间单位",
              "example": "minute",
              "x-enum-descriptions": [
                "取值 minute。",
                "取值 hour。",
                "取值 day。",
                "取值 week。",
                "取值 month。",
                "取值 quarter。",
                "取值 year。"
              ]
            }
          },
          {
            "name": "from",
            "in": "path",
            "description": "`YYYY-MM-DD` 格式的起始日期或毫秒级 Unix 时间戳。",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2025-01-02",
              "description": "`YYYY-MM-DD` 格式的起始日期或毫秒级 Unix 时间戳。"
            }
          },
          {
            "name": "to",
            "in": "path",
            "description": "`YYYY-MM-DD` 格式的结束日期或毫秒级 Unix 时间戳。",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2025-01-31",
              "description": "`YYYY-MM-DD` 格式的结束日期或毫秒级 Unix 时间戳。"
            }
          },
          {
            "name": "adjusted",
            "in": "query",
            "description": "结果是否按股票拆分进行复权。",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "description": "结果是否按股票拆分进行复权。",
              "example": true
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "按行情柱的起始时间戳排序。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc",
              "description": "按行情柱的起始时间戳排序。",
              "example": "asc",
              "x-enum-descriptions": [
                "取值 asc。",
                "取值 desc。"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "为构建结果而查询的基础聚合记录的最大数量。",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000,
              "default": 5000,
              "description": "为构建结果而查询的基础聚合记录的最大数量。",
              "example": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                }
              }
            }
          },
          "default": {
            "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/aggregates/custom-bars"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "官方文档收录的聚合行情接口。"
      }
    },
    "/v3/snapshot": {
      "get": {
        "operationId": "getMarketSnapshot",
        "summary": "获取市场快照",
        "description": "返回一个或多个股票的市场快照。",
        "parameters": [
          {
            "name": "ticker.any_of",
            "in": "query",
            "description": "以逗号分隔的股票代码",
            "required": false,
            "schema": {
              "type": "string",
              "description": "以逗号分隔的股票代码",
              "example": "AAPL"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "按资产类别筛选。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "crypto",
                "fx",
                "indices",
                "options",
                "stocks"
              ],
              "description": "按资产类别筛选。",
              "example": "crypto",
              "x-enum-descriptions": [
                "取值 crypto。",
                "取值 fx。",
                "取值 indices。",
                "取值 options。",
                "取值 stocks。"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "使用选定的排序字段对结果排序。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "使用选定的排序字段对结果排序。",
              "example": "asc",
              "x-enum-descriptions": [
                "取值 asc。",
                "取值 desc。"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "最大结果数量",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 10,
              "description": "最大结果数量",
              "example": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "用于结果排序的字段。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ticker"
              ],
              "description": "用于结果排序的字段。",
              "example": "ticker",
              "x-enum-descriptions": [
                "取值 ticker。"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedSnapshotResponse"
                }
              }
            }
          },
          "default": {
            "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/snapshots/unified-snapshot"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "官方统一市场快照接口；返回字段和数据时效性因资产类别订阅方案而异。"
      }
    },
    "/v3/reference/tickers": {
      "get": {
        "operationId": "listTickers",
        "summary": "搜索证券代码",
        "description": "列出并筛选 Massive 支持的证券。",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "description": "股票代码筛选条件",
            "required": false,
            "schema": {
              "type": "string",
              "description": "股票代码筛选条件",
              "example": "AAPL"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "来自股票代码类型接口的代码类型。",
            "required": false,
            "schema": {
              "type": "string",
              "description": "来自股票代码类型接口的代码类型。",
              "example": "example"
            }
          },
          {
            "name": "market",
            "in": "query",
            "description": "市场筛选条件",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "stocks",
                "crypto",
                "fx",
                "otc",
                "indices"
              ],
              "description": "市场筛选条件",
              "example": "stocks",
              "x-enum-descriptions": [
                "取值 stocks。",
                "取值 crypto。",
                "取值 fx。",
                "取值 otc。",
                "取值 indices。"
              ]
            }
          },
          {
            "name": "exchange",
            "in": "query",
            "description": "主要交易所的市场标识码（MIC），例如 `XNAS`。",
            "required": false,
            "schema": {
              "type": "string",
              "example": "XNAS",
              "description": "主要交易所的市场标识码（MIC），例如 `XNAS`。"
            }
          },
          {
            "name": "cusip",
            "in": "query",
            "description": "要查询的 CUSIP。CUSIP 可用作筛选条件，但出于法律原因不会在结果中返回。",
            "required": false,
            "schema": {
              "type": "string",
              "description": "要查询的 CUSIP。CUSIP 可用作筛选条件，但出于法律原因不会在结果中返回。",
              "example": "example"
            }
          },
          {
            "name": "cik",
            "in": "query",
            "description": "美国证券交易委员会（SEC）中央索引键（CIK）。",
            "required": false,
            "schema": {
              "type": "string",
              "description": "美国证券交易委员会（SEC）中央索引键（CIK）。",
              "example": "example"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "`YYYY-MM-DD` 格式的时点日期；默认为最新可用日期。",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-01-31",
              "description": "`YYYY-MM-DD` 格式的时点日期；默认为最新可用日期。"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "用于匹配股票代码和公司名称的搜索文本。",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Apple",
              "description": "用于匹配股票代码和公司名称的搜索文本。"
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "上市状态筛选条件",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "description": "上市状态筛选条件",
              "example": true
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "使用选定的排序字段对结果排序。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "使用选定的排序字段对结果排序。",
              "example": "asc",
              "x-enum-descriptions": [
                "取值 asc。",
                "取值 desc。"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页结果的最大数量。",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100,
              "description": "每页结果的最大数量。",
              "example": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "用于排序的字段。",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ticker",
                "name",
                "market",
                "locale",
                "primary_exchange",
                "currency_symbol"
              ],
              "description": "用于排序的字段。",
              "example": "ticker",
              "x-enum-descriptions": [
                "取值 ticker。",
                "取值 name。",
                "取值 market。",
                "取值 locale。",
                "取值 primary_exchange。",
                "取值 currency_symbol。"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickerListResponse"
                }
              }
            }
          },
          "default": {
            "description": "请求因身份验证、权限校验、参数验证、速率限制或服务器错误而失败。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/tickers/all-tickers"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "官方参考数据接口。"
      }
    },
