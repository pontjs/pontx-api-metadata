                    "results": {
                      "type": "object",
                      "properties": {
                        "ticker": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "market": {
                          "type": "string"
                        },
                        "primary_exchange": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/tickers/ticker-overview"
