{
  "openapi": "3.0.3",
  "info": {
    "title": "Massive Stock Market Data API",
    "version": "2026-08-10",
    "description": "Curated read-only Massive stock market REST API surface for quotes, aggregates, snapshots, and ticker reference data. Massive was formerly Polygon.io; endpoint access, recency, and history vary by subscription plan.",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.massive.com",
      "description": "Official Massive production REST API"
    }
  ],
  "paths": {
    "/v2/last/trade/{stocksTicker}": {
      "get": {
        "operationId": "getLastTrade",
        "summary": "Get the last stock trade",
        "description": "Retrieve the latest available trade for a case-sensitive stock ticker. The result includes price, size, exchange, conditions, and nanosecond timestamps when supplied by the feed. Availability and recency depend on the account's stock-data plan.",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "Case-sensitive stock ticker, for example `AAPL`.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LastTradeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/trades-quotes/last-trade"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Officially documented endpoint; availability depends on the account's market-data plan.",
        "x-pontx-request-examples": {"default":{"request":{"path":{"stocksTicker":"AAPL"},"query":{},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/v2/aggs/ticker/{stocksTicker}/prev": {
      "get": {
        "operationId": "getPreviousClose",
        "summary": "Get previous-day aggregate",
        "description": "Retrieve the previous trading day's OHLC, volume, VWAP, and transaction count for a stock ticker. Results are split-adjusted by default.",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "Case-sensitive stock ticker, for example `AAPL`.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL"
            }
          },
          {
            "name": "adjusted",
            "in": "query",
            "description": "Return split-adjusted results",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/aggregates/previous-day-bar"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Officially documented aggregate endpoint.",
        "x-pontx-request-examples": {"default":{"request":{"path":{"stocksTicker":"AAPL"},"query":{"adjusted":true},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/v2/aggs/ticker/{stocksTicker}/range/{multiplier}/{timespan}/{from}/{to}": {
      "get": {
        "operationId": "getAggregateBars",
        "summary": "Get custom aggregate bars",
        "description": "Retrieve historical OHLC and volume bars over a custom date range in Eastern Time. Bars are built from qualifying trades; an interval with no eligible trades is omitted rather than returned as an empty bar.",
        "parameters": [
          {
            "name": "stocksTicker",
            "in": "path",
            "description": "Case-sensitive stock ticker, for example `AAPL`.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL"
            }
          },
          {
            "name": "multiplier",
            "in": "path",
            "description": "Timespan multiplier",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "timespan",
            "in": "path",
            "description": "Bar unit",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "minute",
                "hour",
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "example": "minute"
            }
          },
          {
            "name": "from",
            "in": "path",
            "description": "Start date in `YYYY-MM-DD` format or Unix timestamp in milliseconds.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2025-01-02"
            }
          },
          {
            "name": "to",
            "in": "path",
            "description": "End date in `YYYY-MM-DD` format or Unix timestamp in milliseconds.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2025-01-31"
            }
          },
          {
            "name": "adjusted",
            "in": "query",
            "description": "Whether results are adjusted for stock splits.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "example": true
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Order bars by their start timestamp.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc",
              "example": "asc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of base aggregates queried to construct results.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50000,
              "default": 5000,
              "example": 5000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregateResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/aggregates/custom-bars"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Officially documented aggregate endpoint.",
        "x-pontx-request-examples": {"default":{"request":{"path":{"stocksTicker":"AAPL","multiplier":1,"timespan":"minute","from":"2025-01-02","to":"2025-01-31"},"query":{"adjusted":true,"sort":"asc","limit":5000},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/v3/snapshot": {
      "get": {
        "operationId": "getMarketSnapshot",
        "summary": "Get unified market snapshots",
        "description": "Retrieve paginated snapshots across stocks, options, forex, crypto, and indices. A snapshot can include current session metrics plus the latest trade, quote, and minute bar according to plan entitlements.",
        "parameters": [
          {
            "name": "ticker.any_of",
            "in": "query",
            "description": "Comma-separated tickers",
            "required": false,
            "schema": {
              "type": "string",
              "examples": [
                "AAPL"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by asset class.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "crypto",
                "fx",
                "indices",
                "options",
                "stocks"
              ],
              "examples": [
                "stocks"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Order results using the selected sort field.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum results",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 10,
              "example": 10
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field used for result ordering.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ticker"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnifiedSnapshotResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/snapshots/unified-snapshot"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Official unified snapshot endpoint; returned fields and recency vary by asset-class subscription.",
        "x-pontx-request-examples": {"default":{"request":{"path":{},"query":{"limit":10},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/v3/reference/tickers": {
      "get": {
        "operationId": "listTickers",
        "summary": "List and search supported tickers",
        "description": "Retrieve a paginated list of ticker symbols across supported asset classes. Filter by symbol, asset type, market, exchange, identifiers, date, search text, or active status.",
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "description": "Ticker filter",
            "required": false,
            "schema": {
              "type": "string",
              "examples": [
                "A"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Ticker type code from the Ticker Types endpoint.",
            "required": false,
            "schema": {
              "type": "string",
              "examples": [
                "CS"
              ]
            }
          },
          {
            "name": "market",
            "in": "query",
            "description": "Market filter",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "stocks",
                "crypto",
                "fx",
                "otc",
                "indices"
              ],
              "examples": [
                "stocks"
              ]
            }
          },
          {
            "name": "exchange",
            "in": "query",
            "description": "Primary exchange Market Identifier Code (MIC), for example `XNAS`.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "XNAS"
            }
          },
          {
            "name": "cusip",
            "in": "query",
            "description": "CUSIP to query. CUSIPs may be used as filters but are not returned for legal reasons.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cik",
            "in": "query",
            "description": "SEC Central Index Key.",
            "required": false,
            "schema": {
              "type": "string",
              "examples": [
                "0001090872"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Point-in-time date in `YYYY-MM-DD` format; defaults to the latest available date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-01-31"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search text matched against ticker symbols and company names.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Apple"
            }
          },
          {
            "name": "active",
            "in": "query",
            "description": "Active-listing filter",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "example": true
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Order results using the selected sort field.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100,
              "example": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field used for ordering.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ticker",
                "name",
                "market",
                "locale",
                "primary_exchange",
                "currency_symbol"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickerListResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/tickers/all-tickers"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Official reference-data endpoint.",
        "x-pontx-request-examples": {"default":{"request":{"path":{},"query":{"active":true,"limit":100},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/v3/reference/tickers/{ticker}": {
      "get": {
        "operationId": "getTickerDetails",
        "summary": "Get ticker reference details",
        "description": "Get ticker reference details. Official reference-data endpoint.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker",
            "required": true,
            "schema": {
              "type": "string",
              "example": "AAPL"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Point-in-time date in `YYYY-MM-DD` format; defaults to the latest available date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-01-31"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickerDetailsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Request failed because of authentication, authorization, validation, rate limiting, or a server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "official",
        "x-pontx-evidence": [
          "https://massive.com/docs/rest/stocks/tickers/ticker-overview"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Official reference-data endpoint.",
        "x-pontx-request-examples": {"default":{"request":{"path":{"ticker":"AAPL"},"query":{},"headers":{}},"expectedStatus":"200"}}
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "title": "ErrorResponse",
        "type": "object",
        "description": "Error payload returned when Massive cannot authorize or fulfill a request.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Machine-readable request status.",
            "example": "ERROR"
          },
          "error": {
            "type": "string",
            "description": "Short error category or message.",
            "example": "API Key was not provided"
          },
          "message": {
            "type": "string",
            "description": "Additional human-readable error detail."
          },
          "request_id": {
            "type": "string",
            "description": "Server-assigned request identifier for support and diagnostics."
          }
        },
        "additionalProperties": true
      },
      "AggregateBar": {
        "title": "AggregateBar",
        "type": "object",
        "description": "OHLC aggregate constructed from qualifying trades in one time window.",
        "required": [
          "c",
          "h",
          "l",
          "o",
          "t",
          "v"
        ],
        "properties": {
          "T": {
            "type": "string",
            "description": "Exchange ticker symbol; commonly present in previous-day responses.",
            "example": "AAPL"
          },
          "c": {
            "type": "number",
            "description": "Close price.",
            "example": 115.97
          },
          "h": {
            "type": "number",
            "description": "Highest price.",
            "example": 117.59
          },
          "l": {
            "type": "number",
            "description": "Lowest price.",
            "example": 114.13
          },
          "n": {
            "type": "integer",
            "description": "Number of transactions in the aggregate window.",
            "example": 2
          },
          "o": {
            "type": "number",
            "description": "Open price.",
            "example": 115.55
          },
          "otc": {
            "type": "boolean",
            "description": "True for an OTC aggregate; omitted when false."
          },
          "t": {
            "type": "integer",
            "format": "int64",
            "description": "Window start as a Unix timestamp in milliseconds.",
            "example": 1605042000000
          },
          "v": {
            "type": "number",
            "description": "Trading volume.",
            "example": 131704427
          },
          "vw": {
            "type": "number",
            "description": "Volume-weighted average price.",
            "example": 116.3058
          }
        },
        "additionalProperties": true
      },
      "AggregateResponse": {
        "title": "AggregateResponse",
        "type": "object",
        "description": "AggregateResponse data structure",
        "required": [
          "ticker",
          "queryCount",
          "resultsCount",
          "status"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "description": "Exchange ticker symbol.",
            "example": "AAPL"
          },
          "adjusted": {
            "type": "boolean",
            "description": "Whether prices are adjusted for splits.",
            "example": true
          },
          "queryCount": {
            "type": "integer",
            "description": "Number of base minute or day aggregates queried.",
            "example": 1
          },
          "request_id": {
            "type": "string",
            "description": "Server-assigned request identifier.",
            "example": "6a7e466379af0a71039d60cc78e72282"
          },
          "resultsCount": {
            "type": "integer",
            "description": "Number of result bars returned.",
            "example": 1
          },
          "status": {
            "type": "string",
            "description": "Request status.",
            "example": "OK"
          },
          "results": {
            "type": "array",
            "description": "An array of results containing the requested data.",
            "items": {
              "$ref": "#/components/schemas/AggregateBar"
            }
          },
          "next_url": {
            "type": "string",
            "format": "uri",
            "description": "Absolute URL for the next page, when present. Authentication may still need to be supplied.",
            "example": "https://api.massive.com/v2/aggs/ticker/AAPL/range/1/day/1578114000000/2020-01-10?cursor=bGltaXQ9MiZzb3J0PWFzYw"
          }
        },
        "additionalProperties": true
      },
      "LastTrade": {
        "title": "LastTrade",
        "type": "object",
        "description": "LastTrade data structure",
        "required": [
          "T",
          "ds",
          "i",
          "p",
          "q",
          "t",
          "x",
          "y"
        ],
        "properties": {
          "T": {
            "type": "string",
            "description": "Exchange ticker symbol.",
            "example": "AAPL"
          },
          "c": {
            "type": "array",
            "description": "Trade condition codes.",
            "items": {
              "type": "integer",
              "example": 37
            },
            "example": [
              37
            ]
          },
          "ds": {
            "type": "string",
            "description": "Trade size including any fractional component, encoded as a decimal string.",
            "example": "25.0"
          },
          "e": {
            "type": "integer",
            "description": "Trade correction indicator."
          },
          "f": {
            "type": "integer",
            "format": "int64",
            "description": "Trade Reporting Facility receipt time as a Unix timestamp in nanoseconds.",
            "example": 1617901342969796400
          },
          "i": {
            "type": "string",
            "description": "Trade identifier, unique per ticker/exchange/TRF combination.",
            "example": "118749"
          },
          "p": {
            "type": "number",
            "description": "Price per whole share.",
            "example": 129.8473
          },
          "q": {
            "type": "integer",
            "format": "int64",
            "description": "Increasing event sequence number for the ticker; gaps are possible.",
            "example": 3135876
          },
          "r": {
            "type": "integer",
            "description": "Trade Reporting Facility identifier.",
            "example": 202
          },
          "s": {
            "type": "number",
            "description": "Trade size in shares.",
            "example": 25
          },
          "t": {
            "type": "integer",
            "format": "int64",
            "description": "SIP receipt time as a Unix timestamp in nanoseconds.",
            "example": 1617901342969834000
          },
          "x": {
            "type": "integer",
            "description": "Exchange identifier; resolve through Massive exchange reference data.",
            "example": 4
          },
          "y": {
            "type": "integer",
            "format": "int64",
            "description": "Participant/exchange event time as a Unix timestamp in nanoseconds.",
            "example": 1617901342968000000
          },
          "z": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ],
            "description": "Listing tape: 1=A (NYSE), 2=B (NYSE Arca/NYSE American), 3=C (Nasdaq).",
            "example": 3
          }
        },
        "additionalProperties": true
      },
      "LastTradeResponse": {
        "title": "LastTradeResponse",
        "type": "object",
        "description": "LastTradeResponse data structure",
        "required": [
          "request_id",
          "status"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Server-assigned request identifier.",
            "example": "f05562305bd26ced64b98ed68b3c5d96"
          },
          "results": {
            "$ref": "#/components/schemas/LastTrade"
          },
          "status": {
            "type": "string",
            "description": "Request status.",
