        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "Used by FiApp and verified as a public CSV response.",
        "servers": [
          {
            "url": "https://stooq.com"
          }
        ],
        "x-pontx-proxy-headers": {
          "User-Agent": "fi-api/1.0"
        }
      }
    },
    "/q/d/l/": {
      "get": {
        "operationId": "downloadHistoricalQuotes",
        "summary": "Download historical price data",
        "description": "Download historical price data. Linked by provider-owned historical-data pages and validated as read-only CSV.",
        "parameters": [
          {
            "name": "s",
            "in": "query",
            "description": "Stooq symbol",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "d1",
            "in": "query",
            "description": "Start date YYYYMMDD",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "d2",
            "in": "query",
            "description": "End date YYYYMMDD",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "i",
            "in": "query",
            "description": "Interval",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "d",
                "w",
                "m"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
