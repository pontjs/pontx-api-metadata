  "paths": {
    "/q/l/": {
      "get": {
        "operationId": "downloadLatestQuotes",
        "summary": "Download current or latest quotes",
        "description": "Download current or latest quotes. Used by FiApp and verified as a public CSV response.",
        "parameters": [
          {
            "name": "s",
            "in": "query",
            "description": "Comma-separated Stooq symbols",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f",
            "in": "query",
            "description": "Field selection code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "h",
            "in": "query",
            "description": "Include header",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "e",
            "in": "query",
            "description": "Output format",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "x-pontx-documentation-status": "observed",
        "x-pontx-evidence": [
          "https://stooq.com/q/l/?s=aapl.us&f=sd2t2ohlcvp&h&e=csv"
