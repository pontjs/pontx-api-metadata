          },
          {
            "name": "low",
            "type": "string",
            "position": 4
          },
          {
            "name": "volume",
            "type": "string",
            "position": 5
          }
        ]
      },
      "QuoteAssignmentWireText": {
        "type": "string",
        "title": "腾讯报价赋值文本原始响应",
        "description": "GBK 解码的 v_<symbol> JavaScript 赋值文本，不是 JSON 或 HTML；禁止执行，应仅提取引号内容并按波浪号切分，保留空字段。",
        "x-pontx-decoded-record-schema": "#/components/schemas/CommonQuotePositionalRecord",
        "example": "example"
      },
      "CommonQuotePositionalRecord": {
        "type": "object",
        "title": "腾讯跨市场报价解析模型",
        "description": "从赋值文本按位置解析的 A 股、港股和美股公共字段逻辑模型，不是原始响应；未确认的市场特有字段保留在 unmappedFields。",
        "required": [
          "name",
          "code",
          "latest",
          "previousClose",
          "open",
          "time",
          "change",
          "changePercent",
          "high",
          "low"
