              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteType": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "symbol": {
                                "type": "string",
                                "example": "AAPL"
                              },
                              "quoteType": {
                                "type": "string",
                                "description": "由提供商控制的金融工具类别，例如 `EQUITY`、`ETF`、`MUTUALFUND`、`INDEX`、`CURRENCY`、`CRYPTOCURRENCY`、`FUTURE` 或 `OPTION`。此字段特意不设为封闭枚举。"
                              },
                              "longName": {
                                "type": "string",
                                "example": "Apple Inc."
                              },
                              "exchange": {
                                "type": "string",
                                "description": "观测到的 Yahoo 交易所代码；并非封闭的代码表。",
                                "example": "NMS"
                              },
                              "exchangeTimezoneName": {
                                "type": "string",
                                "example": "America/New_York"
                              },
                              "market": {
                                "type": "string",
                                "example": "us_market"
                              }
                            },
                            "additionalProperties": true
                          }
                        },
                        "error": {"$ref": "#/components/schemas/YahooError"}
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "缺少必需的 `symbol` 查询参数时观测到此响应。",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FinanceErrorResponse"}}}
          },
          "429": {"$ref": "#/components/responses/RateLimited"}
        },
        "x-pontx-documentation-status": "observed",
        "x-pontx-evidence": [
          "https://finance.yahoo.com/quote/AAPL/",
          "https://query1.finance.yahoo.com/v1/finance/quoteType/?symbol=AAPL"
        ],
        "x-pontx-verified-at": "2026-08-10",
        "x-pontx-stability-note": "在 Yahoo Finance 行情页面中观测到。",
        "servers": [
          {
            "url": "https://query1.finance.yahoo.com"
          }
