    "/v1/finance/search": {
      "get": {
        "operationId": "searchSymbols",
        "tags": ["Discovery"],
        "summary": "Search securities",
        "description": "Search securities by symbol or name. A query2 anonymous sample returned HTTP 200 on 2026-08-10. Yahoo Help documents the search feature, not this JSON shape; result ranking, auxiliary collections and timing fields can change.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Free-text company name, symbol, fund name, index or other security query.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "Apple"
            }
          },
          {
            "name": "quotesCount",
            "in": "query",
            "description": "Maximum securities",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 6,
              "example": 2
            }
          },
          {
            "name": "newsCount",
            "in": "query",
            "description": "Maximum news results",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 4,
              "example": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed search response. `quotes` is a non-exhaustive projection; the provider can also return news, navigation, lists, research and other collections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "Observed number of returned quote matches.",
                      "example": 2
                    },
                    "quotes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": {
                            "type": "string",
                            "example": "AAPL"
                          },
                          "shortname": {
                            "type": "string"
                          },
                          "longname": {
                            "type": "string"
                          },
                          "exchange": {
                            "type": "string",
                            "example": "NMS"
