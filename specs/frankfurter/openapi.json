        "x-pontx-request-examples": {"default":{"request":{"path":{},"query":{},"headers":{}},"expectedStatus":"200"}}
      }
    }
  },
  "components": {
    "schemas": {
      "ExchangeRateResponse": {
        "title": "汇率响应",
        "type": "object",
        "description": "指定日期的汇率与换算金额。",
        "required": [
          "amount",
          "base",
          "date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "用于换算的金额",
            "example": 1,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "base": {
            "type": "string",
            "description": "基准货币代码（ISO 4217）",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 格式的汇率日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-01-23"
          },
          "rates": {
            "type": "object",
            "description": "以键值对表示的汇率（货币代码对应汇率）",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "example": {
              "USD": 1.0445,
              "GBP": 0.8342,
              "JPY": 161.23,
              "CHF": 0.9234,
              "AUD": 1.6111
            }
          }
        }
      },
      "TimeSeriesResponse": {
        "title": "汇率时间序列响应",
        "type": "object",
        "description": "指定日期区间内的每日汇率集合。",
        "required": [
          "amount",
          "base",
          "start_date",
          "end_date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "用于换算的金额",
            "example": 1,
            "minimum": 0
          },
          "base": {
            "type": "string",
            "description": "基准货币代码（ISO 4217）",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "时间序列的起始日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2023-12-29"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "时间序列的结束日期",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2024-01-31"
          },
          "rates": {
            "type": "object",
            "description": "按日期组织的汇率",
            "additionalProperties": {
              "type": "object",
              "description": "指定日期的汇率",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            },
            "example": {
              "2024-01-01": {
                "USD": 1.1047,
                "GBP": 0.8692
              },
              "2024-01-02": {
                "USD": 1.1023,
                "GBP": 0.8671
              }
            }
          }
        }
      },
      "CurrenciesResponse": {
        "title": "货币列表响应",
        "type": "object",
        "description": "货币代码与货币名称的映射。",
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "EUR": "Euro",
          "USD": "United States Dollar",
          "GBP": "British Pound",
          "JPY": "Japanese Yen",
          "AUD": "Australian Dollar"
        }
      },
      "Error": {
        "title": "错误响应",
        "type": "object",
        "description": "接口未找到汇率数据时返回的错误消息。",
        "properties": {
          "message": {
            "type": "string",
            "description": "服务返回的错误消息",
            "example": "not found"
          }
        }
      }
    },
    "parameters": {
      "AmountParam": {
        "name": "amount",
        "in": "query",
