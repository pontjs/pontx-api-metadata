{
  "openapi": "3.0.3",
  "info": {
    "title": "Frankfurter API",
    "version": "1.0.0",
    "description": "Frankfurter is a free, open-source currency data API that tracks reference exchange rates published by the European Central Bank.\n\n## Features\n- No API keys required\n- No usage limits\n- Daily updates around 16:00 CET\n- Support for 31+ currencies\n- CORS-enabled for browser usage\n- Historical data available\n\n## Data Source\nExchange rates are sourced from the European Central Bank and other financial institutions.\n",
    "contact": {
      "name": "Frankfurter API",
      "url": "https://frankfurter.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/lineofflight/frankfurter/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://api.frankfurter.dev/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Exchange Rates",
      "description": "Operations for retrieving currency exchange rates"
    },
    {
      "name": "Currencies",
      "description": "Operations for listing supported currencies"
    }
  ],
  "paths": {
    "/latest": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "Get latest exchange rates",
        "description": "Retrieves the most recent exchange rates. Rates are updated daily around 16:00 CET.\nBy default, returns all available currencies with EUR as the base currency.\n",
        "operationId": "getLatestRates",
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "description": "The amount to be converted (default is 1)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0,
              "example": 100
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "Base currency code (three-letter ISO 4217 code)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "example": "USD",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of currency codes to limit the response.\nIf not specified, all available currencies are returned.\n",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$",
              "example": "USD,GBP,JPY"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRateResponse"
                },
                "examples": {
                  "default": {
                    "summary": "Default latest rates with EUR base",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "date": "2026-01-23",
                      "rates": {
                        "USD": 1.0445,
                        "GBP": 0.8342,
                        "JPY": 161.23
                      }
                    }
                  },
                  "customAmount": {
                    "summary": "Convert 100 EUR to USD and GBP",
                    "value": {
                      "amount": 100,
                      "base": "EUR",
                      "date": "2026-01-23",
                      "rates": {
                        "USD": 104.45,
                        "GBP": 83.42
                      }
                    }
                  },
                  "differentBase": {
                    "summary": "Latest rates with USD as base",
                    "value": {
                      "amount": 1,
                      "base": "USD",
                      "date": "2026-01-23",
                      "rates": {
                        "EUR": 0.9574,
                        "GBP": 0.7986,
                        "JPY": 154.32
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid parameters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidCurrency": {
                    "summary": "Invalid currency code",
                    "value": {
                      "error": "Invalid base currency",
                      "message": "Currency code XXX is not supported"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/{date}": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "Get historical exchange rates",
        "description": "Retrieves exchange rates for a specific date in the past.\nHistorical data is available from 1999-01-04 onwards.\n",
        "operationId": "getHistoricalRates",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Date in ISO 8601 format (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-15"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "The amount to be converted (default is 1)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "Base currency code (three-letter ISO 4217 code)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of currency codes to limit the response",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with historical exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRateResponse"
                },
                "examples": {
                  "historical": {
                    "summary": "Historical rates for a specific date",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "date": "2024-01-15",
                      "rates": {
                        "USD": 1.0875,
                        "GBP": 0.8563,
                        "JPY": 158.91
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid date format or parameters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No data available for the specified date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/{start_date}..{end_date}": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "Get time series of exchange rates",
        "description": "Retrieves exchange rates for a date range, returning daily rates between the start and end dates (inclusive).\nIf end_date is omitted, returns all rates from start_date to the latest available date.\n",
        "operationId": "getTimeSeriesRates",
        "parameters": [
          {
            "name": "start_date",
            "in": "path",
            "description": "Start date in ISO 8601 format (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-01"
            }
          },
          {
            "name": "end_date",
            "in": "path",
            "description": "End date in ISO 8601 format (YYYY-MM-DD).\nCan be omitted by using format \"start_date..\" to get all rates from start_date onwards.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-31"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "The amount to be converted (default is 1)",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "Base currency code (three-letter ISO 4217 code)",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of currency codes to limit the response",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with time series exchange rates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeSeriesResponse"
                },
                "examples": {
                  "timeSeries": {
                    "summary": "Time series for a date range",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "start_date": "2024-01-01",
                      "end_date": "2024-01-05",
                      "rates": {
                        "2024-01-01": {
                          "USD": 1.1047,
                          "GBP": 0.8692
                        },
                        "2024-01-02": {
                          "USD": 1.1023,
                          "GBP": 0.8671
                        },
                        "2024-01-03": {
                          "USD": 1.0952,
                          "GBP": 0.8643
                        },
                        "2024-01-04": {
                          "USD": 1.0931,
                          "GBP": 0.8625
                        },
                        "2024-01-05": {
                          "USD": 1.0912,
                          "GBP": 0.8604
                        }
                      }
                    }
                  },
                  "openEnded": {
                    "summary": "Open-ended time series (from start_date to latest)",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "start_date": "2024-12-01",
                      "end_date": "2024-12-31",
                      "rates": {
                        "2024-12-01": {
                          "USD": 1.0523,
                          "GBP": 0.8312
                        },
                        "2024-12-02": {
                          "USD": 1.0534,
                          "GBP": 0.8321
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid date format or date range)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No data available for the specified date range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/currencies": {
      "get": {
        "tags": [
          "Currencies"
        ],
        "summary": "Get list of supported currencies",
        "description": "Returns a list of all currency codes supported by the API along with their full names.\nThis endpoint requires no parameters.\n",
        "operationId": "getCurrencies",
        "responses": {
          "200": {
            "description": "Successful response with list of supported currencies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrenciesResponse"
                },
                "examples": {
                  "currencies": {
                    "summary": "List of all supported currencies",
                    "value": {
                      "AUD": "Australian Dollar",
                      "BRL": "Brazilian Real",
                      "CAD": "Canadian Dollar",
                      "CHF": "Swiss Franc",
                      "CNY": "Chinese Renminbi Yuan",
                      "CZK": "Czech Koruna",
                      "DKK": "Danish Krone",
                      "EUR": "Euro",
                      "GBP": "British Pound",
                      "HKD": "Hong Kong Dollar",
                      "HUF": "Hungarian Forint",
                      "IDR": "Indonesian Rupiah",
                      "ILS": "Israeli New Shekel",
                      "INR": "Indian Rupee",
                      "ISK": "Icelandic Króna",
                      "JPY": "Japanese Yen",
                      "KRW": "South Korean Won",
                      "MXN": "Mexican Peso",
                      "MYR": "Malaysian Ringgit",
                      "NOK": "Norwegian Krone",
                      "NZD": "New Zealand Dollar",
                      "PHP": "Philippine Peso",
                      "PLN": "Polish Złoty",
                      "RON": "Romanian Leu",
                      "SEK": "Swedish Krona",
                      "SGD": "Singapore Dollar",
                      "THB": "Thai Baht",
                      "TRY": "Turkish Lira",
                      "USD": "United States Dollar",
                      "ZAR": "South African Rand"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExchangeRateResponse": {
        "type": "object",
        "description": "Response containing exchange rates for a single date",
        "required": [
          "amount",
          "base",
          "date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "The amount used for conversion",
            "example": 1,
            "minimum": 0
          },
          "base": {
            "type": "string",
            "description": "The base currency code (ISO 4217)",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The date of the exchange rates in ISO 8601 format",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-01-23"
          },
          "rates": {
            "type": "object",
            "description": "Exchange rates as key-value pairs (currency code to rate)",
            "additionalProperties": {
              "type": "number",
              "format": "double"
            },
            "example": {
              "USD": 1.0445,
              "GBP": 0.8342,
              "JPY": 161.23,
              "CHF": 0.9234,
              "AUD": 1.6111
            }
          }
        }
      },
      "TimeSeriesResponse": {
        "type": "object",
        "description": "Response containing exchange rates for a date range",
        "required": [
          "amount",
          "base",
          "start_date",
          "end_date",
          "rates"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "The amount used for conversion",
            "example": 1,
            "minimum": 0
          },
          "base": {
            "type": "string",
            "description": "The base currency code (ISO 4217)",
            "pattern": "^[A-Z]{3}$",
            "example": "EUR"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "The start date of the time series",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2024-01-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "The end date of the time series",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2024-01-31"
          },
          "rates": {
            "type": "object",
            "description": "Exchange rates organized by date",
            "additionalProperties": {
              "type": "object",
              "description": "Exchange rates for a specific date",
              "additionalProperties": {
                "type": "number",
                "format": "double"
              }
            },
            "example": {
              "2024-01-01": {
                "USD": 1.1047,
                "GBP": 0.8692
              },
              "2024-01-02": {
                "USD": 1.1023,
                "GBP": 0.8671
              }
            }
          }
        }
      },
      "CurrenciesResponse": {
        "type": "object",
        "description": "Map of currency codes to their full names",
        "additionalProperties": {
          "type": "string"
        },
        "example": {
          "EUR": "Euro",
          "USD": "United States Dollar",
          "GBP": "British Pound",
          "JPY": "Japanese Yen",
          "AUD": "Australian Dollar"
        }
      },
      "Error": {
        "type": "object",
        "description": "Error response",
        "properties": {
          "error": {
            "type": "string",
            "description": "Short error identifier",
            "example": "Invalid base currency"
          },
          "message": {
            "type": "string",
            "description": "Detailed error message",
            "example": "Currency code XXX is not supported"
          }
        }
      }
    },
    "parameters": {
      "AmountParam": {
        "name": "amount",
        "in": "query",
        "description": "The amount to be converted (default is 1)",
        "required": false,
        "schema": {
          "type": "number",
          "format": "double",
          "default": 1,
          "minimum": 0
        }
      },
      "BaseParam": {
        "name": "base",
        "in": "query",
        "description": "Base currency code (three-letter ISO 4217 code)",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "EUR"
        }
      },
      "SymbolsParam": {
        "name": "symbols",
        "in": "query",
        "description": "Comma-separated list of currency codes to limit the response",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
        },
        "style": "form",
        "explode": false
      }
    }
  },
  "externalDocs": {
    "description": "Official Frankfurter API Documentation",
    "url": "https://frankfurter.dev"
  }
}
