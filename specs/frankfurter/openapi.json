{
  "openapi": "3.0.3",
  "info": {
    "title": "Frankfurter API 汇率服务",
    "version": "1.0.0",
    "description": "Frankfurter v1 是一个免费、开源的 API，用于获取当前及历史外汇参考汇率。它无需 API 密钥，支持查询最近工作日汇率、历史汇率、时间序列、按货币筛选以及金额换算。v1 已由 v2 取代，但根据官方文档仍将继续可用。汇率通常在工作日的欧洲中部时间 16:00 左右更新；日期以 UTC 存储，当新汇率发布后，当日查询结果可能发生变化。\n",
    "contact": {
      "name": "Frankfurter API",
      "url": "https://frankfurter.dev"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/lineofflight/frankfurter/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://api.frankfurter.dev/v1",
      "description": "生产服务器"
    }
  ],
  "tags": [
    {
      "name": "Exchange Rates",
      "description": "用于获取货币汇率的接口"
    },
    {
      "name": "Currencies",
      "description": "用于列出受支持货币的接口"
    }
  ],
  "paths": {
    "/latest": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "获取最新汇率",
        "description": "返回最近一个有效参考日的汇率。",
        "operationId": "getLatestRates",
        "deprecated": true,
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "description": "要换算的金额（默认为 1）",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0,
              "exclusiveMinimum": true,
              "example": 100
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "基准货币代码（三位 ISO 4217 代码）",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "example": "USD",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "以逗号分隔的货币代码列表，用于限制响应范围。\n如未指定，则返回所有可用货币。\n",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$",
              "example": "USD,GBP,JPY"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回汇率",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRateResponse"
                },
                "examples": {
                  "default": {
                    "summary": "默认以 EUR 为基准的最新汇率",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "date": "2026-01-23",
                      "rates": {
                        "USD": 1.1742,
                        "GBP": 0.8681,
                        "JPY": 185.71
                      }
                    }
                  },
                  "customAmount": {
                    "summary": "将 100 EUR 换算为 USD 和 GBP",
                    "value": {
                      "amount": 100,
                      "base": "EUR",
                      "date": "2026-01-23",
                      "rates": {
                        "USD": 117.42,
                        "GBP": 86.81
                      }
                    }
                  },
                  "differentBase": {
                    "summary": "以 USD 为基准的最新汇率",
                    "value": {
                      "amount": 1,
                      "base": "USD",
                      "date": "2026-01-23",
                      "rates": {
                        "EUR": 0.85164,
                        "GBP": 0.73931,
                        "JPY": 158.16
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "未找到汇率，例如指定的货币不受支持",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidCurrency": {
                    "summary": "无效的货币代码",
                    "value": {
                      "message": "not found"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "无法处理查询参数，例如金额为零、负数或非数字",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "invalid amount"
                }
              }
            }
          }
        },
        "x-pontx-request-examples": {"default":{"request":{"path":{},"query":{"amount":100,"base":"USD"},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/{date}": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "获取历史汇率",
        "description": "返回指定参考日期的汇率。",
        "operationId": "getHistoricalRates",
        "deprecated": true,
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "ISO 8601 格式的日期（YYYY-MM-DD）",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-15"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "要换算的金额（默认为 1）",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0,
              "exclusiveMinimum": true
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "基准货币代码（三位 ISO 4217 代码）",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "以逗号分隔的货币代码列表，用于限制响应范围",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回历史汇率",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangeRateResponse"
                },
                "examples": {
                  "historical": {
                    "summary": "指定日期的历史汇率",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "date": "2024-01-15",
                      "rates": {
                        "USD": 1.0945,
                        "GBP": 0.86075,
                        "JPY": 159.67
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "指定日期没有可用数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "无法处理日期或查询参数，例如日历日期或金额无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidDate": {
                    "value": {
                      "message": "invalid date"
                    }
                  },
                  "invalidAmount": {
                    "value": {
                      "message": "invalid amount"
                    }
                  }
                }
              }
            }
          }
        },
        "x-pontx-request-examples": {"default":{"request":{"path":{"date":"2024-01-15"},"query":{"amount":1,"base":"EUR"},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/{start_date}..": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "获取开放结束日期的汇率时间序列",
        "description": "从指定起始日期返回到最近有效参考日的每日汇率时间序列。",
        "operationId": "getOpenEndedTimeSeriesRates",
        "deprecated": true,
        "parameters": [
          {
            "name": "start_date",
            "in": "path",
            "description": "ISO 8601 格式的起始日期（YYYY-MM-DD）",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-08-01"
            }
          },
          {
            "$ref": "#/components/parameters/AmountParam"
          },
          {
            "$ref": "#/components/parameters/BaseParam"
          },
          {
            "$ref": "#/components/parameters/SymbolsParam"
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回从请求起始日期到最新观测值的汇率",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeSeriesResponse"
                },
                "example": {
                  "amount": 1,
                  "base": "EUR",
                  "start_date": "2026-07-31",
                  "end_date": "2026-08-07",
                  "rates": {
                    "2026-07-31": {
                      "USD": 1.1485
                    },
                    "2026-08-03": {
                      "USD": 1.1535
                    },
                    "2026-08-07": {
                      "USD": 1.1535
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "指定起始日期没有可用数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "无法处理日期或查询参数，例如日历日期或金额无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-pontx-request-examples": {"default":{"request":{"path":{"start_date":"2026-08-01"},"query":{"amount":1,"base":"EUR"},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/{start_date}..{end_date}": {
      "get": {
        "tags": [
          "Exchange Rates"
        ],
        "summary": "获取汇率时间序列",
        "description": "返回指定日期区间内的汇率变化。",
        "operationId": "getTimeSeriesRates",
        "deprecated": true,
        "parameters": [
          {
            "name": "start_date",
            "in": "path",
            "description": "ISO 8601 格式的起始日期（YYYY-MM-DD）",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-01"
            }
          },
          {
            "name": "end_date",
            "in": "path",
            "description": "ISO 8601 格式的结束日期（YYYY-MM-DD）。\n可使用 \"start_date..\" 格式省略结束日期，以获取从 start_date 起的所有汇率。\n",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2024-01-31"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "要换算的金额（默认为 1）",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 1,
              "minimum": 0,
              "exclusiveMinimum": true
            }
          },
          {
            "name": "base",
            "in": "query",
            "description": "基准货币代码（三位 ISO 4217 代码）",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "default": "EUR",
              "enum": [
                "AUD",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
              ]
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "以逗号分隔的货币代码列表，用于限制响应范围",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}(,[A-Z]{3})*$"
            },
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回时间序列汇率",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeSeriesResponse"
                },
                "examples": {
                  "timeSeries": {
                    "summary": "指定日期范围的时间序列",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "start_date": "2023-12-29",
                      "end_date": "2024-01-05",
                      "rates": {
                        "2023-12-29": {
                          "USD": 1.105,
                          "GBP": 0.86905
                        },
                        "2024-01-02": {
                          "USD": 1.0956,
                          "GBP": 0.86645
                        },
                        "2024-01-03": {
                          "USD": 1.0919,
                          "GBP": 0.8647
                        },
                        "2024-01-04": {
                          "USD": 1.0953,
                          "GBP": 0.86278
                        },
                        "2024-01-05": {
                          "USD": 1.0921,
                          "GBP": 0.8621
                        }
                      }
                    }
                  },
                  "openEnded": {
                    "summary": "开放结束日期的时间序列（从 start_date 到最新日期）",
                    "value": {
                      "amount": 1,
                      "base": "EUR",
                      "start_date": "2024-12-01",
                      "end_date": "2024-12-31",
                      "rates": {
                        "2024-12-01": {
                          "USD": 1.0523,
                          "GBP": 0.8312
                        },
                        "2024-12-02": {
                          "USD": 1.0534,
                          "GBP": 0.8321
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "指定日期范围没有可用数据",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "无法处理日期或查询参数，例如日历日期或金额无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-pontx-request-examples": {"default":{"request":{"path":{"start_date":"2024-01-01","end_date":"2024-01-31"},"query":{"amount":1,"base":"EUR"},"headers":{}},"expectedStatus":"200"}}
      }
    },
    "/currencies": {
