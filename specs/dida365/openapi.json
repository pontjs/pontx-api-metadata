{
  "openapi": "3.0.3",
  "info": {
    "title": "Dida365 Open API",
    "description": "Dida365 is a powerful task management application that allows users to easily manage and organize their daily tasks, deadlines, and projects. With Dida365 Open API, developers can integrate Dida365's powerful task management features into their own applications and create a seamless user experience.",
    "version": "1.0.0",
    "contact": {
      "email": "support@dida365.com"
    }
  },
  "servers": [
    {
      "url": "https://api.dida365.com",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
