{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pontx.dev/schemas/product-skill-evidence.schema.json",
  "title": "Pontx product Skill evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "apiSlug", "claims"],
  "properties": {
    "formatVersion": { "const": 1 },
    "apiSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "summary", "sourceUrl", "sourceType", "verifiedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "claim": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sourceType": {
            "enum": ["official-spec", "official-documentation", "official-sdk", "official-changelog"]
          },
          "verifiedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
