{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pontx.dev/schemas/product-skill-registry.schema.json",
  "title": "Pontx published product Skill registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "skills"],
  "properties": {
    "formatVersion": { "const": 1 },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "apiSlug", "version", "description", "license", "contentHash", "files"],
      "properties": {
        "name": { "type": "string", "pattern": "^pontx-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "apiSlug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "license": { "const": "MIT-0" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?:SKILL\\.md|references/[a-z0-9]+(?:-[a-z0-9]+)*\\.md)$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content": { "type": "string" }
      }
    }
  }
}
